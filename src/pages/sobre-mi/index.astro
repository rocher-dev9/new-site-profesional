---
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
---
<Base
  lang="es"
  pagina="sobre-mi/"
  titulo={"Sobre mí · Roger Avellana"}
  descripcion={"Sobre Roger Avellana — experiencia, educación y herramientas."}
  activa="sobreMi"
>
  <main id="main">

    <header class="about-hero">
      <div class="container about-hero-grid">
        <div>
          <span class="eyebrow">Sobre mí</span>
          <h1>Hola, soy <em>Roger.</em></h1>
          <p class="about-hero-bio">
            Roger Avellana. Diseñador visual y digital con más de ocho años de experiencia en
            proyectos de identidad de marca, UI/UX y comunicación digital. Actualmente ampliando el
            perfil hacia el marketing digital y la estrategia de comunicación, con especial interés
            en la intersección entre diseño de sistemas y herramientas de IA aplicadas al proceso
            creativo.
          </p>
          <div class="about-hero-links">
            <a href="mailto:roger.ar123@gmail.com">roger.ar123@gmail.com</a>
            <a href="https://www.linkedin.com/in/roger-avellana/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://github.com/rocher-dev9" target="_blank" rel="noopener">GitHub</a>
            <span style="color: var(--muted);">Barcelona · Catalunya</span>
          </div>
        </div>
        <div class="hand-art" role="img" aria-label="Mano pixelada saludando">
          <canvas class="hand-field" id="hand-field"></canvas>
        </div>
      </div>
    </header>

    <section>
      <div class="container two-col">
        <div>
          <span class="section-label">/ experiencia</span>
          <div class="timeline" style="margin-top: 16px;">
            <div class="timeline-row">
              <div class="t-main"><strong>Intera</strong><br /><span>Diseño Visual &amp; Estrategia Digital</span></div>
              <div class="t-date">2023–2026</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>nVision Systems</strong><br /><span>Ferias Internacionales</span></div>
              <div class="t-date">2021–2023</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Sensing &amp; Control</strong><br /><span>UI/UX · Dashboard IoT</span></div>
              <div class="t-date">2019–2021</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Ayuntamiento de Igualada</strong><br /><span>Campañas Municipales</span></div>
              <div class="t-date">2018–2019</div>
            </div>
          </div>
        </div>

        <div>
          <span class="section-label">/ educación</span>
          <div class="timeline" style="margin-top: 16px;">
            <div class="timeline-row">
              <div class="t-main"><strong>Escola Superior de Disseny</strong><br /><span>Diseño Gráfico</span></div>
              <div class="t-date">2016</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Universitat Oberta de Catalunya</strong><br /><span>Interacción Digital y Multimedia</span></div>
              <div class="t-date">2020</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Universitat de Barcelona</strong><br /><span>Posgrado Marketing Digital, E-Commerce &amp; Social Media</span></div>
              <div class="t-date">2026</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: var(--bg-soft);">
      <div class="container">
        <span class="section-label">/ herramientas</span>
        <div class="skills-wrap" style="margin-top: 16px;">
          <span class="skill-tag">Adobe Photoshop</span>
          <span class="skill-tag">Adobe Illustrator</span>
          <span class="skill-tag">Adobe InDesign</span>
          <span class="skill-tag">Figma</span>
          <span class="skill-tag">Branding</span>
          <span class="skill-tag">UI/UX Design</span>
          <span class="skill-tag">Marketing digital</span>
          <span class="skill-tag">Redes sociales</span>
          <span class="skill-tag">Claude AI</span>
          <span class="skill-tag">ChatGPT</span>
          <span class="skill-tag">Gemini</span>
          <span class="skill-tag">Microsoft Excel</span>
          <span class="skill-tag">Microsoft Word</span>
          <span class="skill-tag">Google Workspace</span>
        </div>
      </div>
    </section>

    <!-- CONTACTO (unificado con Sobre mí) -->
    <section id="contacto" class="about-contact">
      <div class="container">
        <div class="about-contact-head">
          <span class="section-label">/ contacto</span>
          <h2>Hablemos<em>.</em></h2>
          <p>¿Tienes un proyecto en mente, una marca que necesita orden o una campaña que quieres
            lanzar? Cuéntame en qué estás trabajando y te respondo en cuanto pueda.</p>
        </div>

        <ContactCards lang="es">
          <Fragment slot="proyecto">Escríbeme a <strong>roger.ar123@gmail.com</strong> y te respondo en cuanto pueda.</Fragment>
          <Fragment slot="linkedin">Si prefieres conectar primero, me encuentras en <strong>linkedin.com/in/roger-avellana</strong>.</Fragment>
        </ContactCards>

        <p class="about-contact-meta">Barcelona · Catalunya</p>
      </div>
    </section>

  </main>
</Base>
