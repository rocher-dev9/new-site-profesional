---
import Base from '../layouts/Base.astro';
import ScriptIoi from '../components/scripts/ScriptIoi.astro';
import PageIndex from '../components/PageIndex.astro';
import ContactCards from '../components/ContactCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonials from '../components/Testimonials.astro';
import PixelArrow from '../components/PixelArrow.astro';
import { tarjetas } from '../proyectos/tarjetas';
---
<Base
  lang="es"
  pagina=""
  titulo={"Roger Avellana · Visual Designer & Marketing Assistant"}
  descripcion={"Roger Avellana — Diseño que comunica, estrategia que conecta. Diseño visual, branding, UI/UX y marketing digital en Barcelona."}
  activa="inicio"
  silkscreen
>
  <PageIndex lang="es" secciones={[['top', 'Inicio'], ['servicios', 'Lo que hago'], ['trabajo', 'Proyectos'], ['ia', 'IOI'], ['sobre-mi', 'Sobre mí'], ['testimonios', 'Testimonios'], ['contacto', 'Contacto']]} />

  <main id="main">

    <!-- HERO -->
    <header class="hero" id="top">
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <div class="container hero-center">
        <span class="eyebrow">Diseño y estrategia</span>
        <h1 class="hero-title">Diseño que comunica,<br /><em>estrategia que conecta.</em></h1>
        <p class="hero-sub">
          Ayudo a marcas a convertir el ruido visual en claridad: interfaces afiladas, identidades coherentes y comunicación que conecta.
        </p>

        <form class="hero-chat" id="hero-chat" onsubmit="return false;">
          <label class="visually-hidden" for="hero-chat-input">Cuéntame tu proyecto</label>
          <textarea id="hero-chat-input" class="hc-input" rows="2" placeholder=""></textarea>
          <div class="hc-toolbar">
            <button type="button" class="hc-icon-btn" aria-label="Adjuntar archivo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            <div class="hc-tools-right">
              <button type="button" class="hc-mode">Proyecto <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
              <button type="button" class="hc-icon-btn" aria-label="Dictar con la voz"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button>
              <button type="submit" class="hc-send" aria-label="Enviar encargo"><svg class="hc-send-ico" viewBox="0 0 7 7" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="2" y="0" width="5" height="1"/><rect x="6" y="1" width="1" height="4"/><rect x="4" y="2" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="1" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/></svg></button>
            </div>
          </div>
        </form>

        <div class="hc-chips" role="group" aria-label="Ideas para empezar">
            <button type="button" class="hc-chip" data-topic="branding"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="1" y="1" width="6" height="1"/><rect x="0" y="2" width="1" height="1"/><rect x="7" y="2" width="1" height="1"/><rect x="1" y="3" width="6" height="1"/><rect x="1" y="5" width="6" height="1" opacity=".6"/><rect x="1" y="7" width="6" height="1" opacity=".35"/></svg><span>Branding</span></button>
            <button type="button" class="hc-chip" data-topic="uiux"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="0" y="0" width="8" height="1"/><rect x="0" y="1" width="1" height="4"/><rect x="7" y="1" width="1" height="4"/><rect x="0" y="5" width="8" height="1"/><rect x="2" y="2" width="3" height="1" opacity=".6"/><rect x="3" y="6" width="2" height="1"/><rect x="2" y="7" width="4" height="1"/></svg><span>UI/UX</span></button>
            <button type="button" class="hc-chip" data-topic="marketing"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="6" y="0" width="2" height="1"/><rect x="4" y="1" width="4" height="1"/><rect x="2" y="2" width="5" height="1"/><rect x="0" y="3" width="5" height="1"/><rect x="3" y="4" width="2" height="1"/><rect x="3" y="5" width="1" height="2"/></svg><span>Marketing</span></button>
            <button type="button" class="hc-chip" data-topic="ia"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="3" y="0" width="1" height="2"/><rect x="2" y="2" width="3" height="1"/><rect x="0" y="3" width="7" height="1"/><rect x="2" y="4" width="3" height="1"/><rect x="3" y="5" width="1" height="2"/><rect x="6" y="6" width="1" height="1" opacity=".6"/></svg><span>IA</span></button>
            <button type="button" class="hc-chip" data-topic="design"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="6" y="0" width="2" height="1"/><rect x="5" y="1" width="2" height="1"/><rect x="4" y="2" width="2" height="1"/><rect x="3" y="3" width="2" height="1"/><rect x="2" y="4" width="2" height="1"/><rect x="1" y="5" width="2" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="2" y="7" width="1" height="1" opacity=".6"/><rect x="4" y="7" width="1" height="1" opacity=".6"/></svg><span>Diseño visual</span></button>
        </div>

        <p class="hero-links"><a href="trabajo/">Ver trabajo</a> <span aria-hidden="true">·</span> <a href="sobre-mi/">¿Quién soy?</a></p>
      </div>
    </header>

    <!-- SERVICIOS (teaser) -->
    <section id="servicios" class="pixel-section">
      <canvas class="pixel-field" aria-hidden="true"></canvas>
      <div class="container">
        <div class="pixel-content">
          <span class="section-label">/ servicios</span>
          <h2 style="font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; margin-top: 10px;">
            Lo que hago.
          </h2>
          <p>
            Cinco direcciones donde combino diseño visual con pensamiento estratégico. No son
            silos: se solapan, se nutren entre sí, y al final hablan del mismo proyecto desde
            ángulos distintos.
          </p>
          <div class="skills-wrap">
            <span class="skill-tag">Diseño visual &amp; dirección creativa</span>
            <span class="skill-tag">Branding &amp; identidad corporativa</span>
            <span class="skill-tag">UI/UX &amp; diseño de interfaces</span>
            <span class="skill-tag">Marketing digital &amp; contenido</span>
            <span class="skill-tag">IA aplicada al diseño</span>
          </div>
          <a href="entorno/" class="btn-link">Ver todos los servicios <PixelArrow /></a>
        </div>
      </div>
    </section>

    <!-- TRABAJO (teaser) -->
    <section id="trabajo" style="background: var(--bg-soft);">
      <div class="container">
        <div class="section-head">
          <span class="section-label">/ trabajo</span>
          <h2>Proyectos seleccionados.</h2>
          <p>Una muestra de proyectos de branding, marketing y diseño de interfaces de los
            últimos años.</p>
        </div>

        <p class="swipe-hint" aria-hidden="true">desliza para ver más →</p>
        <div class="work-grid work-grid--swipe">
          {tarjetas.slice(0, 3).map((t) => <ProjectCard tarjeta={t} lang="es" pagina="" />)}
        </div>

        <a href="trabajo/" class="btn-link" style="margin-top: 32px;">Ver todos los proyectos <PixelArrow /></a>
      </div>
    </section>

    <!-- IA (teaser) -->
    <section id="ia" class="ia-teaser">
      <div class="container ia-teaser-grid">
        <div>
          <span class="ia-teaser-label"><span class="ia-teaser-live"></span>/ IOI · inteligencia artificial</span>
          <h2>Diseño con criterio.<br /><span class="ia-teaser-grad">Acelerado por IA.</span></h2>
          <p>
            Integro Claude, ChatGPT y Gemini en el proceso creativo, automatizo las tareas
            repetitivas y diseño agentes de IA que trabajan por pasos. Descubre cómo lo hago y con
            qué principios. La IA propone; el criterio decide.
          </p>
          <a href="ioi/" class="btn ia-teaser-btn">Descubre cómo uso la IA <PixelArrow /></a>
        </div>

        <div class="ioi-perch" data-ioi="home">
          <button type="button" class="ioi-bot" aria-label="IOI, el copiloto de IA de Roger. Haz clic para saludarle">
            <canvas class="ioi-canvas" width="16" height="16" aria-hidden="true"></canvas>
          </button>
          <p class="ioi-bubble" role="status" aria-live="polite"></p>
          <nav class="ioi-term" id="ioi-term" aria-label="Contenido de la sección IOI">
            <div class="it-bar" aria-hidden="true"><span class="it-dots"><i></i><i></i><i></i></span><span class="it-title">roger@ioi: ~</span></div>
            <div class="it-body">
              <p class="it-line" aria-hidden="true"><span class="it-prompt">roger@ioi:~$</span> <span class="it-cmd" style="--chars:7">ls ioi/</span></p>
              <ol class="it-list">
              <li style="--i:0"><a href="ioi/#proceso"><span class="it-n">01</span><span class="it-dir">proceso/</span><span class="it-desc">explorar · generar · refinar · medir</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:1"><a href="ioi/#herramientas"><span class="it-n">02</span><span class="it-dir">herramientas/</span><span class="it-desc">claude · chatgpt · gemini</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:2"><a href="ioi/#automatizacion"><span class="it-n">03</span><span class="it-dir">automatizacion/</span><span class="it-desc">n8n · hermes · openclaw · dots</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:3"><a href="ioi/#agentes"><span class="it-n">04</span><span class="it-dir">agentes/</span><span class="it-desc">tareas por pasos, con supervisión</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:4"><a href="ioi/#principios"><span class="it-n">05</span><span class="it-dir">principios/</span><span class="it-desc">criterio · transparencia · propósito</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              </ol>
              <p class="it-line it-end" aria-hidden="true"><span class="it-prompt">roger@ioi:~$</span> <span class="it-cursor"></span></p>
            </div>
          </nav>
        </div>
      </div>
    </section>

    <!-- SOBRE MÍ (teaser) -->
    <section id="sobre-mi" class="me-section">
      <div class="container">
        <div class="me-card">
          <div class="me-intro">
            <span class="section-label">/ sobre mí</span>
            <div class="me-name">
              <h2>Roger Avellana<em>.</em></h2>
              <canvas class="hand-field me-hand" data-cell="4" role="img" aria-label="Mano pixelada saludando"></canvas>
            </div>
            <p class="me-role">Diseñador visual &amp; digital · Barcelona</p>
            <p class="me-bio">
              Más de ocho años creando identidades de marca, interfaces y comunicación digital. Ahora
              amplío el perfil hacia el marketing digital y la estrategia, con un interés especial por
              cómo la IA puede mejorar el proceso creativo.
            </p>
            <dl class="me-facts">
              <div><dt>+8</dt><dd>años de experiencia</dd></div>
              <div><dt>4</dt><dd>organizaciones</dd></div>
              <div><dt>3</dt><dd>formaciones</dd></div>
            </dl>
            <div class="me-actions">
              <a href="sobre-mi/" class="btn btn-primary">Conóceme mejor <PixelArrow /></a>
              <a href="sobre-mi/#contacto" class="btn btn-ghost">Hablemos</a>
            </div>
          </div>

          <div class="me-panel">
            <span class="me-panel-title">Trayectoria</span>
            <ol class="me-timeline">
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Intera</strong><span>Diseño visual &amp; estrategia digital</span></div><time>2023–2026</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>nVision Systems</strong><span>Ferias internacionales</span></div><time>2021–2023</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Sensing &amp; Control</strong><span>UI/UX · Dashboard IoT</span></div><time>2019–2021</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Ayuntamiento de Igualada</strong><span>Campañas municipales</span></div><time>2018–2019</time></li>
            </ol>
            <span class="me-panel-title">Herramientas</span>
            <div class="me-tools">
              <div class="me-tools-group"><span>Diseño</span><ul><li>Photoshop</li><li>Illustrator</li><li>InDesign</li><li>Figma</li><li>UI/UX</li></ul></div>
              <div class="me-tools-group"><span>IA</span><ul><li>Claude</li><li>ChatGPT</li><li>Gemini</li></ul></div>
              <div class="me-tools-group"><span>Marketing</span><ul><li>Branding</li><li>Marketing digital</li><li>Redes sociales</li><li>Google Workspace</li></ul></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section id="testimonios" style="background: var(--bg-soft);">
      <div class="container">
        <div class="carousel-head">
          <div class="section-head">
            <span class="section-label">/ testimonios</span>
            <h2>Lo que dicen de trabajar conmigo.</h2>
          </div>
          <div class="carousel-controls">
            <button type="button" class="carousel-btn" data-carousel-prev="testi-track" aria-label="Testimonios anteriores"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg></button>
            <button type="button" class="carousel-btn" data-carousel-next="testi-track" aria-label="Testimonios siguientes"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
          </div>
        </div>

        <div class="testi-grid is-carousel" id="testi-track" tabindex="0" aria-label="Testimonios (desliza para ver más)">
          <Testimonials lang="es" />
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto">
      <div class="container">
        <ContactCards lang="es" />
      </div>
    </section>

  </main>
  <Fragment slot="scripts"><ScriptIoi /></Fragment>
</Base>
