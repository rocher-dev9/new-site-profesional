---
import Base from '../layouts/Base.astro';
import ScriptIoi from '../components/scripts/ScriptIoi.astro';
import PageIndex from '../components/PageIndex.astro';
import ContactCards from '../components/ContactCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonials from '../components/Testimonials.astro';
import PixelArrow from '../components/PixelArrow.astro';
import HeroChat from '../components/HeroChat.astro';
import HeroCodigo from '../components/HeroCodigo.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { tarjetas } from '../proyectos/tarjetas';
---
<Base
  lang="es"
  pagina=""
  titulo={"Roger Avellana · Visual Designer & Marketing Assistant"}
  descripcion={"Roger Avellana — Diseño que comunica, estrategia que conecta. Diseño visual, branding, UI/UX y marketing digital en Barcelona."}
  activa="inicio"
>
  <PageIndex lang="es" secciones={[['top', 'Inicio'], ['servicios', 'Lo que hago'], ['trabajo', 'Proyectos'], ['ia', 'IOI'], ['sobre-mi', 'Sobre mí'], ['testimonios', 'Testimonios'], ['contacto', 'Contacto']]} />

  <main id="main">

    <!-- HERO -->
    <header class="hero" id="top">
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <HeroCodigo lang="es" />
      <div class="container hero-split">
        <div class="hero-copy">
          <p class="hero-hola">Hola, soy <em>Roger Avellana</em></p>
          <h1 class="hero-title">Diseño que comunica,<br /><em>estrategia que conecta.</em></h1>
          <p class="hero-oficio">Diseño <em class="hero-oficio-rot" aria-hidden="true" data-palabras="identidades de marca|interfaces|campañas|flujos con IA">identidades de marca</em><span class="visually-hidden">identidades de marca, interfaces, campañas y flujos con IA</span></p>
          <p class="hero-sub">
            Ayudo a marcas a convertir el ruido visual en claridad: interfaces afiladas, identidades coherentes y comunicación que conecta.
          </p>

          <div class="hero-actions">
            <a href="trabajo/" class="btn btn-primary">Ver trabajo <PixelArrow /></a>
            <a href="sobre-mi/" class="btn btn-ghost">¿Quién soy?</a>
            <a href="ioi/" class="hero-ioi"><i aria-hidden="true"></i>IOI · <span>mi copiloto de IA</span> <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <HeroChat lang="es" />
      </div>
    </header>

    <!-- SERVICIOS (teaser) -->
    <section id="servicios" class="pixel-section">
      <canvas class="pixel-field" aria-hidden="true"></canvas>
      <div class="container">
        <div class="pixel-content">
          <span class="section-label"><b>01</b><span>servicios</span></span>
          <h2 style="font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; margin-top: 10px;">
            Lo que hago.
          </h2>
          <p>
            Cinco direcciones donde combino diseño visual con pensamiento estratégico. No son
            silos: se solapan, se nutren entre sí, y al final hablan del mismo proyecto desde
            ángulos distintos.
          </p>
          <a href="entorno/" class="btn-link">Ver todos los servicios <PixelArrow /></a>
        </div>
        <ServiceCards lang="es" pagina="" />
      </div>
    </section>

    <!-- TRABAJO (teaser) -->
    <section id="trabajo" style="background: var(--bg-soft);">
      <div class="container">
        <div class="section-head">
          <span class="section-label"><b>02</b><span>trabajo</span></span>
          <h2>Proyectos seleccionados.</h2>
          <p>Una muestra de proyectos de branding, marketing y diseño de interfaces de los
            últimos años.</p>
        </div>

        <p class="swipe-hint" aria-hidden="true">desliza para ver más →</p>
        <div class="work-grid work-grid--swipe">
          {tarjetas.slice(0, 3).map((t) => <ProjectCard tarjeta={t} lang="es" pagina="" />)}
        </div>

        <a href="trabajo/" class="btn-link" style="margin-top: 32px;">Ver todos los proyectos <PixelArrow /></a>
      </div>
    </section>

    <!-- IA (teaser) -->
    <section id="ia" class="ia-teaser">
      <div class="container ia-teaser-grid">
        <div>
          <span class="section-label"><b>03</b><span>IOI · inteligencia artificial</span></span>
          <h2>Diseño con criterio.<br /><span class="ia-teaser-grad">Acelerado por IA.</span></h2>
          <p>
            Integro Claude, ChatGPT y Gemini en el proceso creativo, automatizo las tareas
            repetitivas y diseño agentes de IA que trabajan por pasos. Descubre cómo lo hago y con
            qué principios. La IA propone; el criterio decide.
          </p>
          <a href="ioi/" class="btn ia-teaser-btn">Descubre cómo uso la IA <PixelArrow /></a>
        </div>

        <div class="ioi-perch" data-ioi="home">
          <button type="button" class="ioi-bot" aria-label="IOI, el copiloto de IA de Roger. Haz clic para saludarle">
            <canvas class="ioi-canvas" width="16" height="16" aria-hidden="true"></canvas>
          </button>
          <p class="ioi-bubble" role="status" aria-live="polite"></p>
          <nav class="ioi-term" id="ioi-term" aria-label="Contenido de la sección IOI">
            <div class="it-bar" aria-hidden="true"><span class="it-dots"><i></i><i></i><i></i></span><span class="it-title">roger@ioi: ~</span></div>
            <div class="it-body">
              <p class="it-line" aria-hidden="true"><span class="it-prompt">roger@ioi:~$</span> <span class="it-cmd" style="--chars:7">ls ioi/</span></p>
              <ol class="it-list">
              <li style="--i:0"><a href="ioi/#proceso"><span class="it-n">01</span><span class="it-dir">proceso/</span><span class="it-desc">explorar · generar · refinar · medir</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:1"><a href="ioi/#herramientas"><span class="it-n">02</span><span class="it-dir">herramientas/</span><span class="it-desc">claude · chatgpt · gemini</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:2"><a href="ioi/#automatizacion"><span class="it-n">03</span><span class="it-dir">automatizacion/</span><span class="it-desc">n8n · hermes · openclaw · dots</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:3"><a href="ioi/#agentes"><span class="it-n">04</span><span class="it-dir">agentes/</span><span class="it-desc">tareas por pasos, con supervisión</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              <li style="--i:4"><a href="ioi/#principios"><span class="it-n">05</span><span class="it-dir">principios/</span><span class="it-desc">criterio · transparencia · propósito</span><span class="it-open" aria-hidden="true">→ abrir</span></a></li>
              </ol>
              <p class="it-line it-end" aria-hidden="true"><span class="it-prompt">roger@ioi:~$</span> <span class="it-cursor"></span></p>
            </div>
          </nav>
        </div>
      </div>
    </section>

    <!-- SOBRE MÍ (teaser) -->
    <section id="sobre-mi" class="me-section">
      <div class="container">
        <div class="me-card">
          <div class="me-intro">
            <span class="section-label"><b>04</b><span>sobre mí</span></span>
            <div class="me-name">
              <h2>Roger Avellana<em>.</em></h2>
              <canvas class="hand-field me-hand" data-cell="4" role="img" aria-label="Mano pixelada saludando"></canvas>
            </div>
            <p class="me-role">Visual Designer &amp; Marketing Assistant · Barcelona</p>
            <p class="me-bio">
              Diseño gráfico y digital desde 2016. Hoy combino branding, UI/UX y marketing digital en
              INTERA-GROUP, con la IA aplicada como eje: flujos con LLM y agentes que producen campañas,
              piezas e informes con un mismo criterio.
            </p>
            <dl class="me-facts">
              <div><dt>+8</dt><dd>años de experiencia</dd></div>
              <div><dt>6</dt><dd>organizaciones</dd></div>
              <div><dt>5</dt><dd>formaciones</dd></div>
            </dl>
            <div class="me-actions">
              <a href="sobre-mi/" class="btn btn-primary">Conóceme mejor <PixelArrow /></a>
              <a href="sobre-mi/#contacto" class="btn btn-ghost">Hablemos</a>
            </div>
          </div>

          <div class="me-panel">
            <span class="me-panel-title">Trayectoria</span>
            <ol class="me-timeline">
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>INTERA-GROUP</strong><span>Diseño visual &amp; marketing</span></div><time>2022–hoy</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>nVision Systems</strong><span>Brand designer</span></div><time>2020–2023</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Sensing &amp; Control</strong><span>Diseño gráfico e identidad</span></div><time>2018–2020</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Ayuntamiento de Igualada</strong><span>Campañas publicitarias</span></div><time>colab.</time></li>
            </ol>
            <span class="me-panel-title">Herramientas</span>
            <div class="me-tools">
              <div class="me-tools-group"><span>Diseño</span><ul><li>Photoshop</li><li>Illustrator</li><li>InDesign</li><li>Figma</li><li>UI/UX</li></ul></div>
              <div class="me-tools-group"><span>IA</span><ul><li>Claude</li><li>ChatGPT</li><li>Gemini</li><li>Agentes de IA</li></ul></div>
              <div class="me-tools-group"><span>Marketing</span><ul><li>Branding</li><li>SEO</li><li>GA4</li><li>Google Ads</li><li>Email marketing</li></ul></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section id="testimonios" style="background: var(--bg-soft);">
      <div class="container">
        <div class="carousel-head">
          <div class="section-head">
            <span class="section-label"><b>05</b><span>testimonios</span></span>
            <h2>Lo que dicen de trabajar conmigo.</h2>
          </div>
          <div class="carousel-controls">
            <button type="button" class="carousel-btn" data-carousel-prev="testi-track" aria-label="Testimonios anteriores"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg></button>
            <button type="button" class="carousel-btn" data-carousel-next="testi-track" aria-label="Testimonios siguientes"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
          </div>
        </div>

        <div class="testi-grid is-carousel" id="testi-track" tabindex="0" aria-label="Testimonios (desliza para ver más)">
          <Testimonials lang="es" />
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto">
      <div class="container">
        <ContactCards lang="es" />
      </div>
    </section>

  </main>
  <Fragment slot="scripts"><ScriptIoi /></Fragment>
</Base>
