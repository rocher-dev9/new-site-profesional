---
import Base from '../../layouts/Base.astro';
import ScriptIoi from '../../components/scripts/ScriptIoi.astro';
import PageIndex from '../../components/PageIndex.astro';
import ContactCards from '../../components/ContactCards.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Testimonials from '../../components/Testimonials.astro';
import PixelArrow from '../../components/PixelArrow.astro';
import HeroChat from '../../components/HeroChat.astro';
import HeroCodigo from '../../components/HeroCodigo.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import { tarjetas } from '../../proyectos/tarjetas';
---
<Base
  lang="en"
  pagina="en/index.html"
  titulo={"Roger Avellana · Visual Designer & Marketing Assistant"}
  descripcion={"Roger Avellana — Design that communicates, strategy that connects. Visual design, branding, UI/UX and digital marketing in Barcelona."}
  activa="inicio"
>
  <PageIndex lang="en" secciones={[['top', 'Home'], ['services', 'What I do'], ['work', 'Projects'], ['ai', 'IOI'], ['about', 'About'], ['testimonials', 'Testimonials'], ['contact', 'Contact']]} />

  <main id="main">

    <!-- HERO -->
    <header class="hero" id="top">
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <HeroCodigo lang="en" />
      <div class="container hero-split">
        <div class="hero-copy">
          <p class="hero-hola">Hi, I’m <em>Roger Avellana</em></p>
          <h1 class="hero-title">Design that communicates,<br /><em>strategy that connects.</em></h1>
          <p class="hero-oficio">I design <em class="hero-oficio-rot" aria-hidden="true" data-palabras="brand identities|interfaces|campaigns|AI workflows">brand identities</em><span class="visually-hidden">brand identities, interfaces, campaigns and AI workflows</span></p>
          <p class="hero-sub">
            I help brands turn visual noise into clarity: sharp interfaces, consistent identities and communication that connects.
          </p>

          <div class="hero-actions">
            <a href="work.html" class="btn btn-primary">See my work <PixelArrow /></a>
            <a href="about.html" class="btn btn-ghost">Who am I?</a>
            <a href="ai.html" class="hero-ioi"><i aria-hidden="true"></i>IOI · <span>my AI copilot</span> <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <HeroChat lang="en" />
      </div>
    </header>

    <!-- SERVICIOS (teaser) -->
    <section id="services" class="pixel-section">
      <canvas class="pixel-field" aria-hidden="true"></canvas>
      <div class="container">
        <div class="pixel-content">
          <span class="section-label"><b>01</b><span>services</span></span>
          <h2 style="font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; margin-top: 10px;">
            What I do.
          </h2>
          <p>
            Five directions where I combine visual design with strategic thinking. They aren't silos: they overlap, feed each other and, in the end, speak about the same project from different angles.
          </p>
          <a href="services.html" class="btn-link">See all services <PixelArrow /></a>
        </div>
        <ServiceCards lang="en" pagina="en/index.html" />
      </div>
    </section>

    <!-- TRABAJO (teaser) -->
    <section id="work" style="background: var(--bg-soft);">
      <div class="container">
        <div class="section-head">
          <span class="section-label"><b>02</b><span>work</span></span>
          <h2>Selected projects.</h2>
          <p>A selection of branding, marketing and interface design projects from recent years.</p>
        </div>

        <p class="swipe-hint" aria-hidden="true">swipe to see more →</p>
        <div class="work-grid work-grid--swipe">
          {tarjetas.slice(0, 3).map((t) => <ProjectCard tarjeta={t} lang="en" pagina="en/index.html" />)}
        </div>

        <a href="work.html" class="btn-link" style="margin-top: 32px;">See all projects <PixelArrow /></a>
      </div>
    </section>

    <!-- IA (teaser) -->
    <section id="ai" class="ia-teaser">
      <div class="container ia-teaser-grid">
        <div>
          <span class="section-label"><b>03</b><span>IOI · artificial intelligence</span></span>
          <h2>Design with judgment.<br /><span class="ia-teaser-grad">Accelerated by AI.</span></h2>
          <p>
            I integrate Claude, ChatGPT and Gemini into the creative process, automate repetitive tasks and design AI agents that work step by step. Discover how I do it and the principles behind it. AI proposes; judgment decides.
          </p>
          <a href="ai.html" class="btn ia-teaser-btn">Discover how I use AI <PixelArrow /></a>
        </div>

        <div class="ioi-perch" data-ioi="home">
          <button type="button" class="ioi-bot" aria-label="IOI, Roger's AI copilot. Click to say hi">
            <canvas class="ioi-canvas" width="16" height="16" aria-hidden="true"></canvas>
          </button>
          <p class="ioi-bubble" role="status" aria-live="polite"></p>
          <nav class="ioi-term" id="ioi-term" aria-label="Contents of the IOI section">
            <div class="it-bar" aria-hidden="true"><span class="it-dots"><i></i><i></i><i></i></span><span class="it-title">roger@ioi: ~</span></div>
            <div class="it-body">
              <p class="it-line" aria-hidden="true"><span class="it-prompt">roger@ioi:~$</span> <span class="it-cmd" style="--chars:7">ls ioi/</span></p>
              <ol class="it-list">
              <li style="--i:0"><a href="ai.html#process"><span class="it-n">01</span><span class="it-dir">process/</span><span class="it-desc">explore · generate · refine · measure</span><span class="it-open" aria-hidden="true">→ open</span></a></li>
              <li style="--i:1"><a href="ai.html#tools"><span class="it-n">02</span><span class="it-dir">tools/</span><span class="it-desc">claude · chatgpt · gemini</span><span class="it-open" aria-hidden="true">→ open</span></a></li>
              <li style="--i:2"><a href="ai.html#automation"><span class="it-n">03</span><span class="it-dir">automation/</span><span class="it-desc">n8n · hermes · openclaw · dots</span><span class="it-open" aria-hidden="true">→ open</span></a></li>
              <li style="--i:3"><a href="ai.html#agents"><span class="it-n">04</span><span class="it-dir">agents/</span><span class="it-desc">step-by-step tasks, supervised</span><span class="it-open" aria-hidden="true">→ open</span></a></li>
              <li style="--i:4"><a href="ai.html#principles"><span class="it-n">05</span><span class="it-dir">principles/</span><span class="it-desc">judgment · transparency · purpose</span><span class="it-open" aria-hidden="true">→ open</span></a></li>
              </ol>
              <p class="it-line it-end" aria-hidden="true"><span class="it-prompt">roger@ioi:~$</span> <span class="it-cursor"></span></p>
            </div>
          </nav>
        </div>
      </div>
    </section>

    <!-- SOBRE MÍ (teaser) -->
    <section id="about" class="me-section">
      <div class="container">
        <div class="me-card">
          <div class="me-intro">
            <span class="section-label"><b>04</b><span>about me</span></span>
            <div class="me-name">
              <h2>Roger Avellana<em>.</em></h2>
              <canvas class="hand-field me-hand" data-cell="4" role="img" aria-label="Pixel hand waving"></canvas>
            </div>
            <p class="me-role">Visual &amp; digital designer · Barcelona</p>
            <p class="me-bio">
              Over eight years creating brand identities, interfaces and digital communication. Now
              expanding into digital marketing and strategy, with a special interest in how AI can
              improve the creative process.
            </p>
            <dl class="me-facts">
              <div><dt>+8</dt><dd>years of experience</dd></div>
              <div><dt>4</dt><dd>organizations</dd></div>
              <div><dt>3</dt><dd>degrees &amp; courses</dd></div>
            </dl>
            <div class="me-actions">
              <a href="about.html" class="btn btn-primary">Get to know me <PixelArrow /></a>
              <a href="about.html#contact" class="btn btn-ghost">Let's talk</a>
            </div>
          </div>

          <div class="me-panel">
            <span class="me-panel-title">Career</span>
            <ol class="me-timeline">
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Intera</strong><span>Visual design &amp; digital strategy</span></div><time>2023–2026</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>nVision Systems</strong><span>International trade fairs</span></div><time>2021–2023</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Sensing &amp; Control</strong><span>UI/UX · IoT dashboard</span></div><time>2019–2021</time></li>
              <li><span class="me-dot" aria-hidden="true"></span><div><strong>Igualada City Council</strong><span>Municipal campaigns</span></div><time>2018–2019</time></li>
            </ol>
            <span class="me-panel-title">Tools</span>
            <div class="me-tools">
              <div class="me-tools-group"><span>Design</span><ul><li>Photoshop</li><li>Illustrator</li><li>InDesign</li><li>Figma</li><li>UI/UX</li></ul></div>
              <div class="me-tools-group"><span>AI</span><ul><li>Claude</li><li>ChatGPT</li><li>Gemini</li></ul></div>
              <div class="me-tools-group"><span>Marketing</span><ul><li>Branding</li><li>Digital marketing</li><li>Social media</li><li>Google Workspace</li></ul></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIOS -->
    <section id="testimonials" style="background: var(--bg-soft);">
      <div class="container">
        <div class="carousel-head">
          <div class="section-head">
            <span class="section-label"><b>05</b><span>testimonials</span></span>
            <h2>What people say about working with me.</h2>
          </div>
          <div class="carousel-controls">
            <button type="button" class="carousel-btn" data-carousel-prev="testi-track" aria-label="Previous testimonials"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg></button>
            <button type="button" class="carousel-btn" data-carousel-next="testi-track" aria-label="Next testimonials"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
          </div>
        </div>

        <div class="testi-grid is-carousel" id="testi-track" tabindex="0" aria-label="Testimonials (swipe to see more)">
          <Testimonials lang="en" />
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contact">
      <div class="container">
        <ContactCards lang="en" />
      </div>
    </section>

  </main>
  <Fragment slot="scripts"><ScriptIoi /></Fragment>
</Base>
