---
import Base from '../../layouts/Base.astro';
---
<Base
  lang="en"
  pagina="en/index.html"
  titulo={"Roger Avellana · Visual Designer & Marketing Assistant"}
  descripcion={"Roger Avellana — Design that communicates, strategy that connects. Visual design, branding, UI/UX and digital marketing in Barcelona."}
  activa="inicio"
  silkscreen
  js={["js/ioi.js"]}
>
  <nav class="page-index" aria-label="Page sections">
    <a href="#top"><b>01</b><i aria-hidden="true"></i><span>Home</span></a>
    <a href="#services"><b>02</b><i aria-hidden="true"></i><span>What I do</span></a>
    <a href="#work"><b>03</b><i aria-hidden="true"></i><span>Projects</span></a>
    <a href="#ai"><b>04</b><i aria-hidden="true"></i><span>IOI</span></a>
    <a href="#about"><b>05</b><i aria-hidden="true"></i><span>About</span></a>
    <a href="#testimonials"><b>06</b><i aria-hidden="true"></i><span>Testimonials</span></a>
    <a href="#contact"><b>07</b><i aria-hidden="true"></i><span>Contact</span></a>
  </nav>
  <a href="#top" class="to-top" aria-label="Back to top"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg></a>

  <main id="main">

    <!-- HERO -->
    <header class="hero" id="top">
      <canvas class="hero-dots" aria-hidden="true"></canvas>
      <div class="container hero-center">
        <span class="eyebrow">Design &amp; strategy</span>
        <h1 class="hero-title">Design that communicates,<br /><em>strategy that connects.</em></h1>
        <p class="hero-sub">
          I help brands turn visual noise into clarity: sharp interfaces, consistent identities and communication that connects.
        </p>

        <form class="hero-chat" id="hero-chat" onsubmit="return false;">
          <label class="visually-hidden" for="hero-chat-input">Tell me about your project</label>
          <textarea id="hero-chat-input" class="hc-input" rows="2" placeholder=""></textarea>
          <div class="hc-toolbar">
            <button type="button" class="hc-icon-btn" aria-label="Attach a file"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
            <div class="hc-tools-right">
              <button type="button" class="hc-mode">Project <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>
              <button type="button" class="hc-icon-btn" aria-label="Dictate with your voice"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></button>
              <button type="submit" class="hc-send" aria-label="Send brief"><svg class="hc-send-ico" viewBox="0 0 7 7" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="2" y="0" width="5" height="1"/><rect x="6" y="1" width="1" height="4"/><rect x="4" y="2" width="1" height="1"/><rect x="3" y="3" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="1" y="5" width="1" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="5" y="1" width="1" height="1"/></svg></button>
            </div>
          </div>
        </form>

        <div class="hc-chips" role="group" aria-label="Ideas to get started">
            <button type="button" class="hc-chip" data-topic="branding"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="1" y="1" width="6" height="1"/><rect x="0" y="2" width="1" height="1"/><rect x="7" y="2" width="1" height="1"/><rect x="1" y="3" width="6" height="1"/><rect x="1" y="5" width="6" height="1" opacity=".6"/><rect x="1" y="7" width="6" height="1" opacity=".35"/></svg><span>Branding</span></button>
            <button type="button" class="hc-chip" data-topic="uiux"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="0" y="0" width="8" height="1"/><rect x="0" y="1" width="1" height="4"/><rect x="7" y="1" width="1" height="4"/><rect x="0" y="5" width="8" height="1"/><rect x="2" y="2" width="3" height="1" opacity=".6"/><rect x="3" y="6" width="2" height="1"/><rect x="2" y="7" width="4" height="1"/></svg><span>UI/UX</span></button>
            <button type="button" class="hc-chip" data-topic="marketing"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="6" y="0" width="2" height="1"/><rect x="4" y="1" width="4" height="1"/><rect x="2" y="2" width="5" height="1"/><rect x="0" y="3" width="5" height="1"/><rect x="3" y="4" width="2" height="1"/><rect x="3" y="5" width="1" height="2"/></svg><span>Marketing</span></button>
            <button type="button" class="hc-chip" data-topic="ia"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="3" y="0" width="1" height="2"/><rect x="2" y="2" width="3" height="1"/><rect x="0" y="3" width="7" height="1"/><rect x="2" y="4" width="3" height="1"/><rect x="3" y="5" width="1" height="2"/><rect x="6" y="6" width="1" height="1" opacity=".6"/></svg><span>AI</span></button>
            <button type="button" class="hc-chip" data-topic="design"><svg viewBox="0 0 8 8" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="6" y="0" width="2" height="1"/><rect x="5" y="1" width="2" height="1"/><rect x="4" y="2" width="2" height="1"/><rect x="3" y="3" width="2" height="1"/><rect x="2" y="4" width="2" height="1"/><rect x="1" y="5" width="2" height="1"/><rect x="0" y="6" width="1" height="1"/><rect x="2" y="7" width="1" height="1" opacity=".6"/><rect x="4" y="7" width="1" height="1" opacity=".6"/></svg><span>Visual design</span></button>
        </div>

        <p class="hero-links"><a href="work.html">See my work</a> <span aria-hidden="true">·</span> <a href="about.html">Who am I?</a></p>
      </div>
    </header>

    <!-- SERVICIOS (teaser) -->
    <section id="services" class="pixel-section">
      <canvas class="pixel-field" aria-hidden="true"></canvas>
      <div class="container">
        <div class="pixel-content">
          <span class="section-label">/ services</span>
          <h2 style="font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; margin-top: 10px;">
            What I do.
          </h2>
          <p>
            Five directions where I combine visual design with strategic thinking. They aren't silos: they overlap, feed each other and, in the end, speak about the same project from different angles.
          </p>
          <div class="skills-wrap">
            <span class="skill-tag">Visual design &amp; art direction</span>
            <span class="skill-tag">Branding &amp; corporate identity</span>
            <span class="skill-tag">UI/UX &amp; interface design</span>
            <span class="skill-tag">Digital marketing &amp; content</span>
            <span class="skill-tag">AI applied to design</span>
          </div>
          <a href="services.html" class="btn-link">See all services <svg class="px-arrow" viewBox="0 0 8 5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="4" y="0" width="1" height="1"/><rect x="4" y="1" width="2" height="1"/><rect x="0" y="2" width="7" height="1"/><rect x="4" y="3" width="2" height="1"/><rect x="4" y="4" width="1" height="1"/></svg></a>
        </div>
      </div>
    </section>

    <!-- TRABAJO (teaser) -->
    <section id="work" style="background: var(--bg-soft);">
      <div class="container">
        <div class="section-head">
          <span class="section-label">/ work</span>
          <h2>Selected projects.</h2>
          <p>A selection of branding, marketing and interface design projects from recent years.</p>
        </div>

        <p class="swipe-hint" aria-hidden="true">swipe to see more →</p>
        <div class="work-grid work-grid--swipe">
          <article class="project-card">
            <div class="project-cover" style="background:#504FED;">
              <span class="p-tag">branding</span>
              <span class="p-year">2024</span>
              <span class="p-num">01</span>
              <svg class="p-art" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" font-family="Plus Jakarta Sans, sans-serif"><defs><filter id="psh1" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#15121f" flood-opacity=".28" /></filter></defs>
                <g filter="url(#psh1)">
                  <g transform="rotate(-9 215 150)">
                    <rect x="150" y="80" width="200" height="120" rx="10" fill="#15121f" />
                    <circle cx="185" cy="118" r="11" fill="#fff" /><circle cx="189" cy="114" r="4.5" fill="#15121f" />
                    <rect x="170" y="170" width="70" height="4" rx="2" fill="#fff" opacity=".35" />
                    <rect x="170" y="180" width="46" height="4" rx="2" fill="#fff" opacity=".35" />
                  </g>
                  <g transform="rotate(5 190 190)">
                    <rect x="80" y="125" width="220" height="130" rx="10" fill="#fff" />
                    <circle cx="122" cy="172" r="16" fill="#504FED" /><circle cx="127" cy="166" r="6.5" fill="#fff" />
                    <text x="148" y="180" font-size="26" font-weight="800" letter-spacing="-1.2" fill="#15121f">intera</text>
                    <rect x="104" y="214" width="96" height="5" rx="2.5" fill="#dbd6f9" />
                    <rect x="104" y="226" width="62" height="5" rx="2.5" fill="#dbd6f9" />
                    <rect x="236" y="212" width="42" height="20" rx="10" fill="#504FED" />
                  </g>
                </g>
                <g>
                  <circle cx="46" cy="92" r="10" fill="#fff" /><circle cx="68" cy="92" r="10" fill="#15121f" />
                  <circle cx="90" cy="92" r="10" fill="#fbe2c6" />
                </g>
              </svg>
            </div>
            <div class="project-body">
              <h3>Intera — corporate identity</h3>
              <p>Complete redesign of the visual identity: logo, palette, typography and brand system applied to all corporate materials.</p>
              <a href="#" class="btn-link">View case <svg class="px-arrow" viewBox="0 0 8 5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="4" y="0" width="1" height="1"/><rect x="4" y="1" width="2" height="1"/><rect x="0" y="2" width="7" height="1"/><rect x="4" y="3" width="2" height="1"/><rect x="4" y="4" width="1" height="1"/></svg></a>
            </div>
          </article>
          <article class="project-card">
            <div class="project-cover" style="background:#D9482C;">
              <span class="p-tag">marketing</span>
              <span class="p-year">2018–2019</span>
              <span class="p-num">02</span>
              <svg class="p-art" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" font-family="Plus Jakarta Sans, sans-serif"><defs><filter id="psh2" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#15121f" flood-opacity=".28" /></filter></defs>
                <g filter="url(#psh2)">
                  <rect x="92" y="58" width="138" height="200" rx="6" fill="#fbe2c6" />
                  <circle cx="161" cy="118" r="36" fill="#D9482C" />
                  <circle cx="161" cy="118" r="18" fill="#fbe2c6" opacity=".45" />
                  <rect x="108" y="172" width="104" height="14" rx="2" fill="#15121f" />
                  <rect x="108" y="191" width="74" height="14" rx="2" fill="#15121f" />
                  <rect x="108" y="218" width="64" height="4" rx="2" fill="#15121f" opacity=".45" />
                  <rect x="108" y="228" width="48" height="4" rx="2" fill="#15121f" opacity=".45" />
                  <rect x="196" y="224" width="18" height="18" rx="3" fill="#D9482C" />
                </g>
                <g filter="url(#psh2)">
                  <rect x="250" y="96" width="92" height="176" rx="16" fill="#15121f" />
                  <rect x="257" y="106" width="78" height="156" rx="10" fill="#fff" />
                  <circle cx="268" cy="118" r="5" fill="#D9482C" />
                  <rect x="277" y="115" width="32" height="5" rx="2.5" fill="#15121f" opacity=".7" />
                  <rect x="263" y="130" width="66" height="66" rx="5" fill="#fbe2c6" />
                  <circle cx="296" cy="158" r="15" fill="#D9482C" />
                  <rect x="276" y="178" width="40" height="7" rx="1.5" fill="#15121f" />
                  <path d="M266 207c0-3 4-4 5-1 1-3 5-2 5 1 0 3-5 6-5 6s-5-3-5-6z" fill="#D9482C" />
                  <rect x="282" y="206" width="30" height="4" rx="2" fill="#15121f" opacity=".3" />
                  <rect x="263" y="220" width="60" height="4" rx="2" fill="#15121f" opacity=".2" />
                  <rect x="263" y="230" width="44" height="4" rx="2" fill="#15121f" opacity=".2" />
                </g>
              </svg>
            </div>
            <div class="project-body">
              <h3>Igualada City Council — campaigns</h3>
              <p>Design and production of graphic materials for municipal campaigns: posters, digital banners and social media posts.</p>
              <a href="#" class="btn-link">View case <svg class="px-arrow" viewBox="0 0 8 5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="4" y="0" width="1" height="1"/><rect x="4" y="1" width="2" height="1"/><rect x="0" y="2" width="7" height="1"/><rect x="4" y="3" width="2" height="1"/><rect x="4" y="4" width="1" height="1"/></svg></a>
            </div>
          </article>
          <article class="project-card">
            <div class="project-cover" style="background:#0E8A5A;">
              <span class="p-tag">ui/ux</span>
              <span class="p-year">2019–2021</span>
              <span class="p-num">03</span>
              <svg class="p-art" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" font-family="Plus Jakarta Sans, sans-serif"><defs><filter id="psh3" x="-30%" y="-30%" width="160%" height="160%"><feDropShadow dx="0" dy="12" stdDeviation="12" flood-color="#15121f" flood-opacity=".28" /></filter></defs>
                <g filter="url(#psh3)">
                  <rect x="46" y="62" width="308" height="206" rx="10" fill="#fff" />
                </g>
                <circle cx="60" cy="75" r="3.5" fill="#f7d3aa" /><circle cx="71" cy="75" r="3.5" fill="#dcf3e8" /><circle cx="82" cy="75" r="3.5" fill="#dcf3e8" />
                <rect x="54" y="88" width="42" height="172" rx="6" fill="#eef6f2" />
                <rect x="62" y="98" width="18" height="18" rx="5" fill="#0E8A5A" />
                <rect x="62" y="128" width="26" height="4" rx="2" fill="#0E8A5A" opacity=".35" />
                <rect x="62" y="140" width="22" height="4" rx="2" fill="#0E8A5A" opacity=".35" />
                <rect x="62" y="152" width="26" height="4" rx="2" fill="#0E8A5A" opacity=".35" />
                <g>
                  <rect x="104" y="88" width="76" height="44" rx="6" fill="#f4f8f6" />
                  <rect x="112" y="97" width="30" height="4" rx="2" fill="#15121f" opacity=".35" />
                  <rect x="112" y="108" width="44" height="12" rx="2" fill="#15121f" />
                  <circle cx="168" cy="100" r="4" fill="#0E8A5A" />
                  <rect x="188" y="88" width="76" height="44" rx="6" fill="#f4f8f6" />
                  <rect x="196" y="97" width="30" height="4" rx="2" fill="#15121f" opacity=".35" />
                  <rect x="196" y="108" width="36" height="12" rx="2" fill="#15121f" />
                  <circle cx="252" cy="100" r="4" fill="#e0a82e" />
                  <rect x="272" y="88" width="74" height="44" rx="6" fill="#f4f8f6" />
                  <rect x="280" y="97" width="30" height="4" rx="2" fill="#15121f" opacity=".35" />
                  <rect x="280" y="108" width="40" height="12" rx="2" fill="#15121f" />
                  <circle cx="334" cy="100" r="4" fill="#0E8A5A" />
                </g>
                <rect x="104" y="140" width="160" height="120" rx="6" fill="#f4f8f6" />
                <path d="M114 236 L136 214 L156 222 L178 190 L200 200 L222 170 L254 160 L254 250 L114 250Z" fill="#0E8A5A" opacity=".14" />
                <polyline points="114,236 136,214 156,222 178,190 200,200 222,170 254,160" fill="none" stroke="#0E8A5A" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
                <circle cx="222" cy="170" r="4" fill="#fff" stroke="#0E8A5A" stroke-width="2" />
                <rect x="114" y="150" width="46" height="4" rx="2" fill="#15121f" opacity=".35" />
                <rect x="272" y="140" width="74" height="120" rx="6" fill="#f4f8f6" />
                <path d="M284 214 A25 25 0 0 1 334 214" fill="none" stroke="#dcf3e8" stroke-width="8" stroke-linecap="round" />
                <path d="M284 214 A25 25 0 0 1 324 194" fill="none" stroke="#0E8A5A" stroke-width="8" stroke-linecap="round" />
