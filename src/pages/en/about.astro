---
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
---
<Base
  lang="en"
  pagina="en/about.html"
  titulo={"About · Roger Avellana"}
  descripcion={"About Roger Avellana — visual and marketing designer in Barcelona: experience, education, applied AI and tools."}
  activa="sobreMi"
>
  <main id="main" class="pg-rt">

    <header class="about-hero">
      <div class="container about-hero-grid">
        <div>
          <span class="eyebrow">About</span>
          <h1>Hi, I'm <em>Roger.</em></h1>
          <p class="about-hero-rol">Visual Designer &amp; Marketing Assistant · Generative AI · UI/UX</p>
          <p class="about-hero-bio">I've worked in graphic and digital design since 2016. Over time, that visual foundation has moved towards digital interaction, marketing and applied AI, which is now my main field.</p>
          <p class="about-hero-bio">At INTERA-GROUP, a B2B company in embedded AI, semiconductors (ASIC, FPGA, RISC-V) and IoT for the industrial and defence sectors, I combine interface design and branding with digital marketing: LinkedIn, email marketing, Google Ads and web content, with a data-driven approach focused on generating qualified leads.</p>
          <div class="about-hero-links">
            <a href="mailto:roger.ar123@gmail.com">roger.ar123@gmail.com</a>
            <a href="https://www.linkedin.com/in/roger-avellana/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://github.com/rocher-dev9" target="_blank" rel="noopener">GitHub</a>
            <span style="color: var(--muted);">Barcelona · Catalonia</span>
          </div>
        </div>
        <div class="hand-art" role="img" aria-label="Pixel hand waving">
          <canvas class="hand-field" id="hand-field"></canvas>
        </div>
      </div>
    </header>

    <section>
      <div class="container">
        <div class="pg-rt-label"><span class="section-label"><b>01</b><span>approach</span></span></div>
        <div class="section-head">
          <h2>AI at the core of <em>my work.</em></h2>
          <p>I turn technologies like Edge AI, TinyML and AI accelerators into visual content that is accurate and business-focused.</p>
        </div>
        <div class="case-summary">
          <article class="cs-card">
            <span class="cs-num">01</span>
            <h3>LLM workflows and agents</h3>
            <p>I design and roll out LLM-based workflows and AI agents to produce campaigns, graphics, video and analytics reports.</p>
          </article>
          <article class="cs-card">
            <span class="cs-num">02</span>
            <h3>My own skills ecosystem</h3>
            <p>My own set of skills keeps tone, terminology and quality consistent across everything I produce.</p>
          </article>
          <article class="cs-card">
            <span class="cs-num">03</span>
            <h3>Tools chosen with judgment</h3>
            <p>I work across several models and assess every tool for security, regulatory compliance and real return before adopting it.</p>
          </article>
        </div>
      </div>
    </section>

    <section style="background: var(--bg-soft);">
      <div class="container two-col">
        <div class="pg-rt-label pg-rt-label--a"><span class="section-label"><b>02</b><span>experience</span></span></div>
        <div class="pg-rt-label pg-rt-label--b"><span class="section-label"><b>03</b><span>education</span></span></div>
        <div>
          <div class="timeline">
            <div class="timeline-row">
              <div class="t-main"><strong>INTERA-GROUP</strong><br /><span>Visual Designer &amp; Marketing Assistant</span></div>
              <div class="t-date">2023–now</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>INTERA-GROUP</strong><br /><span>Brand &amp; UI Designer</span></div>
              <div class="t-date">2022–2023</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>nVision Systems &amp; Technologies</strong><br /><span>Brand Designer</span></div>
              <div class="t-date">2020–2023</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Club Bàsquet Igualada</strong><br /><span>Social media</span></div>
              <div class="t-date">2019–2020</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Sensing &amp; Control Systems</strong><br /><span>Graphic design and brand identity</span></div>
              <div class="t-date">2018–2020</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Igualada City Council</strong><br /><span>Advertising campaigns</span></div>
              <div class="t-date">collaboration</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Motobuykers</strong><br /><span>Design internship</span></div>
              <div class="t-date">2016</div>
            </div>
          </div>
        </div>

        <div>
          <div class="timeline">
            <div class="timeline-row">
              <div class="t-main"><strong>Universitat de Barcelona</strong><br /><span>Postgraduate Degree in Digital Marketing, E-Commerce &amp; Social Media</span></div>
              <div class="t-date">2026</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Universitat Oberta de Catalunya</strong><br /><span>Bachelor’s Degree in Digital Interaction and Multimedia</span></div>
              <div class="t-date">2020–2026</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Escuela de Organización Industrial</strong><br /><span>“Generación Digital: Agentes del Cambio” programme</span></div>
              <div class="t-date">2023</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Escola Municipal d'Art Gaspar Camps</strong><br /><span>Advertising graphics</span></div>
              <div class="t-date">2018–2020</div>
            </div>
            <div class="timeline-row">
              <div class="t-main"><strong>Escola Municipal d'Art Gaspar Camps</strong><br /><span>Print graphics production</span></div>
              <div class="t-date">2016–2018</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="container">
        <div class="pg-rt-label"><span class="section-label"><b>04</b><span>tools</span></span></div>
        <div class="skills-wrap">
          <span class="skill-tag">Adobe Photoshop</span>
          <span class="skill-tag">Adobe Illustrator</span>
          <span class="skill-tag">Adobe InDesign</span>
          <span class="skill-tag">Figma</span>
          <span class="skill-tag">Branding</span>
          <span class="skill-tag">UI/UX</span>
          <span class="skill-tag">Design systems</span>
          <span class="skill-tag">Digital marketing</span>
          <span class="skill-tag">Marketing strategy</span>
          <span class="skill-tag">SEO</span>
          <span class="skill-tag">GA4</span>
          <span class="skill-tag">Google Ads</span>
          <span class="skill-tag">Email marketing</span>
          <span class="skill-tag">LinkedIn</span>
          <span class="skill-tag">Claude</span>
          <span class="skill-tag">ChatGPT</span>
          <span class="skill-tag">Gemini</span>
          <span class="skill-tag">AI agents</span>
          <span class="skill-tag">Google Workspace</span>
        </div>
      </div>
    </section>

    <!-- CONTACTO (unificado con Sobre mí) -->
    <section id="contact" class="about-contact">
      <div class="container">
        <div class="pg-rt-label"><span class="section-label"><b>05</b><span>contact</span></span></div>
        <div class="about-contact-head">
          <h2>Let's talk<em>.</em></h2>
          <p>Have a project in mind, a brand that needs order or a campaign you want to launch? Tell me what you're working on and I'll get back to you as soon as I can.</p>
        </div>

        <ContactCards lang="en">
          <Fragment slot="proyecto">Email me at <strong>roger.ar123@gmail.com</strong> and I'll get back to you as soon as I can.</Fragment>
          <Fragment slot="linkedin">If you'd rather connect first, you'll find me at <strong>linkedin.com/in/roger-avellana</strong>.</Fragment>
        </ContactCards>

        <p class="about-contact-meta">Barcelona · Catalonia</p>
      </div>
    </section>

  </main>
</Base>
