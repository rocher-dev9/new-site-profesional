---
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { tarjetas } from '../../proyectos/tarjetas';
---
<Base
  lang="en"
  pagina="en/work.html"
  titulo={"Work · Roger Avellana"}
  descripcion={"Selected projects by Roger Avellana — branding, marketing and interface design."}
  activa="trabajo"
>
  <main id="main">

    <header class="about-hero page-hero">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Work</span>
          <h1>Selected <em>projects.</em></h1>
          <p class="about-hero-bio">
            A selection of branding, marketing and interface design projects from recent years.
          </p>
        </div>

        <div class="work-deck" id="work-deck" role="region" aria-roledescription="carousel"
          aria-label="Featured projects">
          <div class="deck-stage" id="deck-stage"></div>
          <div class="deck-controls">
            <button class="deck-btn" id="deck-prev" type="button" aria-label="Previous project">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M11 18l-6-6 6-6" />
              </svg>
            </button>
            <div class="deck-dots" id="deck-dots"></div>
            <button class="deck-btn" id="deck-next" type="button" aria-label="Next project">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>
          </div>
          <div class="deck-pills" aria-hidden="true">
            <div class="hero-pill dp-1"><span class="dot">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5850EC" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </svg>
              </span>6 projects</div>
            <div class="hero-pill dp-2"><span class="dot">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8834A" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>from brief to delivery</div>
          </div>
        </div>
      </div>
    </header>

    <section class="work-section" id="projects" style="background: var(--bg-soft);">
      <div class="container">
        <div class="work-intro">
          <div class="work-intro-text">
            <span class="section-label">/ approach</span>
            <p class="work-intro-lead">Every project starts with a question: <em>what does the viewer need to understand?</em> From there, design, strategy and AI work together so the answer is clear, consistent and measurable.</p>
            <p>I work with tech companies, public institutions and growing brands: from complete identities and trade fair stands to industrial dashboards and social media content strategies.</p>
          </div>
          <dl class="work-stats">
            <div><dt>+8</dt><dd>years designing brands, campaigns and interfaces</dd></div>
            <div><dt>4</dt><dd>organizations: business, industry and public sector</dd></div>
            <div><dt>5</dt><dd>disciplines: branding, marketing, UI/UX, design and AI</dd></div>
          </dl>
        </div>

        <div class="work-grid">
          {tarjetas.map((t) => <ProjectCard tarjeta={t} lang="en" pagina="en/work.html" />)}
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <ContactCards lang="en" />
      </div>
    </section>

  </main>
</Base>
