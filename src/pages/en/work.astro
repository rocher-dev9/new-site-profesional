---
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
import WorkDeck from '../../components/WorkDeck.astro';
import WorkRow from '../../components/WorkRow.astro';
import WorkRowManual from '../../components/WorkRowManual.astro';
import { tarjetas } from '../../proyectos/tarjetas';
---
<Base
  lang="en"
  pagina="en/work.html"
  titulo={"Work · Roger Avellana"}
  descripcion={"Selected projects by Roger Avellana — branding, marketing and interface design."}
  activa="trabajo"
>
  <main id="main">

    <header class="about-hero page-hero">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Work</span>
          <h1>Selected <em>projects.</em></h1>
          <p class="about-hero-bio">
            A selection of branding, marketing and interface design projects from recent years.
          </p>
        </div>

        <WorkDeck lang="en" />
      </div>
    </header>

    <section class="work-section" id="projects" style="background: var(--bg-soft);">
      <div class="container">
        <div class="work-intro">
          <div class="work-intro-text">
            <span class="section-label">/ approach</span>
            <p class="work-intro-lead">Every project starts with a question: <em>what does the viewer need to understand?</em> From there, design, strategy and AI work together so the answer is clear, consistent and measurable.</p>
            <p>I work with tech companies, public institutions and growing brands: from complete identities and trade fair stands to industrial dashboards and social media content strategies.</p>
          </div>
          <dl class="work-stats">
            <div><dt>+8</dt><dd>years designing brands, campaigns and interfaces</dd></div>
            <div><dt>4</dt><dd>organizations: business, industry and public sector</dd></div>
            <div><dt>5</dt><dd>disciplines: branding, marketing, UI/UX, design and AI</dd></div>
          </dl>
        </div>

        <div class="wk-list">
          {tarjetas.map((t) => <WorkRow tarjeta={t} lang="en" pagina="en/work.html" />)}
          <WorkRowManual lang="en" pagina="en/work.html" />
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="container">
        <ContactCards lang="en" />
      </div>
    </section>

  </main>
</Base>
