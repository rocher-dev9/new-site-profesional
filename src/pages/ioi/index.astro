---
import Base from '../../layouts/Base.astro';
import ScriptIa from '../../components/scripts/ScriptIa.astro';
import ScriptIoi from '../../components/scripts/ScriptIoi.astro';
import PageIndex from '../../components/PageIndex.astro';
import PixelArrow from '../../components/PixelArrow.astro';
---
<Base
  lang="es"
  pagina="ioi/"
  titulo={"IOI · Inteligencia artificial · Roger Avellana"}
  descripcion={"Cómo Roger Avellana integra la inteligencia artificial en el diseño y el marketing: proceso, herramientas, automatización (n8n, Hermes Agent, OpenClaw, OpenAI Dots), agentes de IA y principios."}
  activa="ioi"
  colorTema="#0b0a16"
  claseBody="theme-ai"
>
  <PageIndex lang="es" secciones={[['top', 'Inicio'], ['proceso', 'Proceso'], ['herramientas', 'Herramientas'], ['automatizacion', 'Automatización'], ['agentes', 'Agentes'], ['principios', 'Principios'], ['contacto', 'Contacto']]} oscuro />

  <main id="main">

    <!-- HERO IA -->
    <header class="ai-hero" id="top">
      <canvas class="neural-field" id="neural-field" aria-hidden="true"></canvas>
      <div class="ai-hero-grid-bg" aria-hidden="true"></div>
      <div class="container ai-hero-grid">
        <div>
          <span class="ai-eyebrow"><span class="ai-live"></span>IOI · inteligencia artificial · modo activo</span>
          <h1 class="aip-title">Diseño con criterio.<br /><span class="ai-gradient-text">Acelerado por IA.</span></h1>
          <p class="ai-lead">
            Integro la inteligencia artificial en el proceso creativo, automatizo las tareas
            repetitivas y diseño agentes que ejecutan trabajo por pasos. La IA propone; el criterio decide.
          </p>
          <div class="ai-actions">
            <a href="#proceso" class="btn ai-btn">Ver el proceso <PixelArrow /></a>
            <a href="../sobre-mi/#contacto" class="btn ai-btn-ghost">Hablemos</a>
          </div>
          <dl class="ai-meta">
            <div><dt>3</dt><dd>modelos de IA en el día a día</dd></div>
            <div><dt>4</dt><dd>fases del proceso asistidas</dd></div>
            <div><dt>100%</dt><dd>decisiones con criterio humano</dd></div>
          </dl>
        </div>

        <div class="ioi-perch" data-ioi="lab">
          <button type="button" class="ioi-bot" aria-label="IOI, el copiloto de IA de Roger. Haz clic para saludarle">
            <canvas class="ioi-canvas" width="16" height="16" aria-hidden="true"></canvas>
          </button>
          <p class="ioi-bubble" role="status" aria-live="polite"></p>
        <div class="ai-console" aria-hidden="true">
          <div class="ai-console-bar">
            <span class="ai-dots"><i></i><i></i><i></i></span>
            <span class="ai-console-title">roger@ioi ~</span>
            <span class="ai-model" id="console-model">claude</span>
          </div>
          <div class="ai-console-body">
            <p class="ai-line ai-line--user"><span class="ai-sign">›</span><span><span id="console-prompt">Propón tres conceptos para una marca de café de especialidad</span><span class="ai-cursor"></span></span></p>
            <p class="ai-line ai-line--bot"><span class="ai-sign ai-sign--bot">✦</span><span id="console-answer">1. «Origen»: tipografía serif y tonos tierra. 2. «Ritual»: minimalismo cálido. 3. «Tueste»: contraste y textura.</span></p>
          </div>
          <div class="ai-console-foot">
            <span><span class="ai-live"></span><span id="console-status">respuesta lista</span></span>
            <span id="console-tokens">42 tokens</span>
          </div>
        </div>
        </div>
      </div>
    </header>

    <!-- PROCESO -->
    <section class="ai-section" id="proceso">
      <div class="container">
        <div class="ai-head">
          <span class="aip-label">/ proceso</span>
          <h2>Cuatro fases. <span class="ai-gradient-text">Una sola dirección.</span></h2>
          <p>La IA no sustituye ninguna fase del diseño: acelera las que más tiempo consumen para que
            el esfuerzo vaya donde de verdad marca la diferencia.</p>
        </div>

        <ol class="ai-pipeline">
          <li class="ai-step">
            <span class="ai-step-num">01</span>
            <span class="ai-step-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg></span>
            <h3>Explorar</h3>
            <p>Investigación de mercado, referentes y territorios creativos. La IA amplía el abanico;
              yo selecciono qué merece la pena desarrollar.</p>
          </li>
          <li class="ai-step">
            <span class="ai-step-num">02</span>
            <span class="ai-step-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4L12 3z" /><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2z" /></svg></span>
            <h3>Generar</h3>
            <p>Variantes de concepto, copys, paletas y estructuras de contenido en poco tiempo, para
              comparar opciones reales y no hipótesis.</p>
          </li>
          <li class="ai-step">
            <span class="ai-step-num">03</span>
            <span class="ai-step-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z" /><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" /></svg></span>
            <h3>Refinar</h3>
            <p>Aquí manda el oficio: tipografía, composición, tono de marca y detalle. La IA asiste;
              el diseño final es mío.</p>
          </li>
          <li class="ai-step">
            <span class="ai-step-num">04</span>
            <span class="ai-step-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18" /><path d="M7 15l4-4 3 3 5-6" /></svg></span>
            <h3>Medir</h3>
            <p>Análisis de métricas y resultados de campaña para entender qué funciona y alimentar la
              siguiente iteración.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- HERRAMIENTAS -->
    <section class="ai-section" id="herramientas">
      <div class="container">
        <div class="ai-head">
          <span class="aip-label">/ herramientas</span>
          <h2>Mi stack de <span class="ai-gradient-text">IA.</span></h2>
          <p>Tres modelos, cada uno con su papel. Elegir la herramienta adecuada para cada tarea es
            parte del criterio.</p>
        </div>

        <div class="ai-tools">
          <article class="ai-tool" style="--tool: #e8834a;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">estrategia y escritura</span></div>
            <h3>Claude</h3>
            <ul>
              <li>Copys, guiones y tono de marca</li>
              <li>Estructura de contenidos</li>
              <li>Análisis y síntesis de información</li>
            </ul>
          </article>
          <article class="ai-tool" style="--tool: #3fbf8a;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">ideación</span></div>
            <h3>ChatGPT</h3>
            <ul>
              <li>Lluvia de ideas y conceptos</li>
              <li>Variantes de mensajes</li>
              <li>Prototipado rápido de textos</li>
            </ul>
          </article>
          <article class="ai-tool" style="--tool: #8f88ff;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">investigación</span></div>
            <h3>Gemini</h3>
            <ul>
              <li>Búsqueda y contraste de referencias</li>
              <li>Trabajo con Google Workspace</li>
              <li>Resúmenes de documentos</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- AUTOMATIZACIÓN -->
    <section class="ai-section" id="automatizacion">
      <div class="container">
        <div class="ai-head">
          <span class="aip-label">/ automatización</span>
          <h2>Flujos que trabajan <span class="ai-gradient-text">mientras tú creas.</span></h2>
          <p>Conecto herramientas con IA para automatizar las tareas repetitivas del día a día:
            borradores, informes, briefs. Siempre con un punto de revisión humana antes de que
            nada salga fuera.</p>
        </div>

        <div class="ai-flow-tabs" role="tablist" aria-label="Ejemplos de automatización">
          <button type="button" role="tab" class="ai-flow-tab" aria-selected="true" data-flow="0">Contenido</button>
          <button type="button" role="tab" class="ai-flow-tab" aria-selected="false" data-flow="1">Informes</button>
          <button type="button" role="tab" class="ai-flow-tab" aria-selected="false" data-flow="2">Briefs</button>
        </div>

        <div class="ai-flow" id="ai-flow" role="tabpanel">
          <div class="ai-node">
            <span class="ai-node-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" /></svg></span>
            <span class="ai-node-kind">disparador</span>
            <strong class="ai-node-text">Nueva idea en el calendario editorial</strong>
          </div>
          <span class="ai-link" aria-hidden="true"><i></i></span>
          <div class="ai-node ai-node--ai">
            <span class="ai-node-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.6L18 9l-4.2 1.4L12 15l-1.8-4.6L6 9l4.2-1.4L12 3z" /><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8.8-2z" /></svg></span>
            <span class="ai-node-kind">IA</span>
            <strong class="ai-node-text">Redacta borradores de copy y variantes por canal</strong>
          </div>
          <span class="ai-link" aria-hidden="true"><i></i></span>
          <div class="ai-node ai-node--human">
            <span class="ai-node-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg></span>
            <span class="ai-node-kind">revisión humana</span>
            <strong class="ai-node-text">Ajusto tono, mensaje y diseño</strong>
          </div>
          <span class="ai-link" aria-hidden="true"><i></i></span>
          <div class="ai-node">
            <span class="ai-node-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13" /><path d="M22 2l-7 20-4-9-9-4 20-7z" /></svg></span>
            <span class="ai-node-kind">acción</span>
            <strong class="ai-node-text">Publicación programada en redes</strong>
          </div>
        </div>

        <div class="ai-auto-list">
          <h3 class="ai-auto-title">Qué se puede automatizar</h3>
          <ul>
            <li>Informes de métricas</li>
            <li>Borradores de contenido</li>
            <li>Clasificación de briefs</li>
            <li>Respuestas tipo</li>
            <li>Organización de assets</li>
            <li>Seguimiento de tareas</li>
          </ul>
        </div>

        <div class="ai-platforms-head">
          <h3 class="ai-auto-title">Plataformas y agentes</h3>
          <p>Elijo la herramienta según el proyecto: desde flujos visuales hasta agentes autónomos que
            trabajan por su cuenta. Con todas aplico los mismos límites: <strong>permisos mínimos, entornos
            aislados y revisión humana antes de actuar.</strong></p>
        </div>
        <div class="ai-platforms">
          <article class="ai-tool ai-platform" style="--tool: #f7b98a;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">orquestación de flujos</span></div>
            <h3>n8n</h3>
            <p>Plataforma de automatización con editor visual de nodos. Conecta cientos de apps y
              servicios con pasos de IA, y se puede alojar en servidor propio.</p>
            <ul class="ai-platform-tags"><li>low-code</li><li>autoalojable</li></ul>
          </article>
          <article class="ai-tool ai-platform" style="--tool: #3fbf8a;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">agente que aprende</span></div>
            <h3>Hermes Agent</h3>
            <p>Agente de código abierto de Nous Research. Funciona en tu servidor, recuerda entre
              sesiones y convierte las tareas que resuelve en habilidades reutilizables.</p>
            <ul class="ai-platform-tags"><li>código abierto</li><li>memoria</li></ul>
          </article>
          <article class="ai-tool ai-platform" style="--tool: #8f88ff;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">agente en tus apps</span></div>
            <h3>OpenClaw</h3>
            <p>Agente de código abierto que se conecta a WhatsApp, Telegram, Slack o el email y
              ejecuta acciones reales desde la conversación.</p>
            <ul class="ai-platform-tags"><li>código abierto</li><li>mensajería</li></ul>
          </article>
          <article class="ai-tool ai-platform" style="--tool: #ece9ff;">
            <div class="ai-tool-top"><span class="ai-tool-dot"></span><span class="ai-tool-role">agentes siempre activos</span></div>
            <h3>OpenAI Dots</h3>
            <p>Agentes de ChatGPT que siguen trabajando cuando termina la conversación, con su propio
              ordenador en la nube y reglas para pedir aprobación antes de actuar.</p>
            <ul class="ai-platform-tags"><li>ChatGPT</li><li>nube</li></ul>
          </article>
        </div>
      </div>
    </section>

    <!-- AGENTES -->
    <section class="ai-section" id="agentes">
      <div class="container">
        <div class="ai-head">
          <span class="aip-label">/ agentes de IA</span>
          <h2>Agentes que <span class="ai-gradient-text">piensan en pasos.</span></h2>
          <p>Un agente no se limita a responder: recibe un objetivo, lo divide en pasos, usa
            herramientas y ejecuta varias tareas seguidas. Los diseño para que trabajen dentro de
            límites claros y siempre bajo supervisión.</p>
        </div>

        <div class="ai-agents-grid">
          <div class="ai-agent" id="ai-agent">
            <div class="ai-agent-bar">
              <span class="ai-dots"><i></i><i></i><i></i></span>
              <span class="ai-agent-name">agente · investigación de mercado</span>
              <button type="button" class="ai-agent-run" id="ai-agent-run">▶ Ejecutar</button>
            </div>
            <ol class="ai-agent-log">
              <li><span class="ai-agent-state"></span><span><b>Objetivo</b> Analiza 5 competidores de una marca de café de especialidad</span></li>
              <li><span class="ai-agent-state"></span><span><b>Plan</b> búsqueda → comparación → síntesis</span></li>
              <li><span class="ai-agent-state"></span><span><b>Herramienta</b> búsqueda web · 5 marcas identificadas</span></li>
              <li><span class="ai-agent-state"></span><span><b>Herramienta</b> análisis de redes · tono, formatos y frecuencia</span></li>
              <li><span class="ai-agent-state"></span><span><b>Síntesis</b> 3 oportunidades de diferenciación detectadas</span></li>
              <li><span class="ai-agent-state"></span><span><b>Revisión</b> informe listo para validar</span></li>
            </ol>
            <div class="ai-agent-foot"><span id="ai-agent-status">listo para ejecutar</span><span id="ai-agent-steps">0 / 6 pasos</span></div>
          </div>

          <div class="ai-agent-types">
            <article class="ai-agent-type">
              <span class="ai-agent-type-key">investigación</span>
              <h3>Agente de investigación</h3>
              <p>Analiza competencia, tendencias y referentes, y entrega un resumen con
                oportunidades para el proyecto.</p>
            </article>
            <article class="ai-agent-type">
              <span class="ai-agent-type-key">contenido</span>
              <h3>Agente de contenido</h3>
              <p>Adapta una pieza a cada canal siguiendo la guía de marca: formatos, longitudes y
                tono.</p>
            </article>
            <article class="ai-agent-type">
              <span class="ai-agent-type-key">análisis</span>
              <h3>Agente de análisis</h3>
              <p>Revisa métricas de forma periódica, detecta cambios y propone ajustes para la
                siguiente campaña.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- PRINCIPIOS -->
    <section class="ai-section" id="principios">
      <div class="container">
        <div class="ai-head">
          <span class="aip-label">/ principios</span>
          <h2>Cómo trabajo <span class="ai-gradient-text">con IA.</span></h2>
        </div>
        <div class="ai-principles">
          <div class="ai-principle">
            <span class="ai-principle-key">01 · criterio</span>
            <h3>La decisión es humana</h3>
            <p>La IA genera opciones; el gusto, la decisión final y la responsabilidad sobre el
              resultado son míos.</p>
          </div>
          <div class="ai-principle">
            <span class="ai-principle-key">02 · transparencia</span>
            <h3>Sin cajas negras</h3>
            <p>Explico qué partes de cada proyecto se han trabajado con IA y cómo, para que el
              cliente sepa siempre qué está recibiendo.</p>
          </div>
          <div class="ai-principle">
            <span class="ai-principle-key">03 · propósito</span>
            <h3>Velocidad con sentido</h3>
            <p>Ahorrar tiempo en lo repetitivo para invertirlo en lo que marca la diferencia: la
              idea, el detalle y la estrategia.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ai-section ai-section--cta" id="contacto">
      <div class="container">
        <div class="ai-cta">
          <span class="aip-label">/ siguiente paso</span>
          <h2>¿Llevamos la IA <span class="ai-gradient-text">a tu marca?</span></h2>
          <p>Cuéntame tu proyecto y vemos juntos dónde puede aportar más: en el proceso creativo, en
            el contenido o en el análisis.</p>
          <div class="ai-actions">
            <a href="mailto:roger.ar123@gmail.com" class="btn ai-btn">Escríbeme <PixelArrow /></a>
            <a href="../trabajo/" class="btn ai-btn-ghost">Ver proyectos</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Fragment slot="scripts"><ScriptIa /><ScriptIoi /></Fragment>
</Base>
