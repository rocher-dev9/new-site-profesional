---
import Base from '../../layouts/Base.astro';
import ContactCards from '../../components/ContactCards.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { tarjetas } from '../../proyectos/tarjetas';
---
<Base
  lang="es"
  pagina="trabajo/"
  titulo={"Trabajo · Roger Avellana"}
  descripcion={"Proyectos seleccionados de Roger Avellana — branding, marketing y diseño de interfaces."}
  activa="trabajo"
>
  <main id="main">

    <header class="about-hero page-hero">
      <div class="container page-hero-grid">
        <div>
          <span class="eyebrow">Trabajo</span>
          <h1>Proyectos <em>seleccionados.</em></h1>
          <p class="about-hero-bio">
            Una muestra de proyectos de branding, marketing y diseño de interfaces de los
            últimos años.
          </p>
        </div>

        <div class="work-deck" id="work-deck" role="region" aria-roledescription="carrusel"
          aria-label="Proyectos destacados">
          <div class="deck-stage" id="deck-stage"></div>
          <div class="deck-controls">
            <button class="deck-btn" id="deck-prev" type="button" aria-label="Proyecto anterior">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M11 18l-6-6 6-6" />
              </svg>
            </button>
            <div class="deck-dots" id="deck-dots"></div>
            <button class="deck-btn" id="deck-next" type="button" aria-label="Proyecto siguiente">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>
          </div>
          <div class="deck-pills" aria-hidden="true">
            <div class="hero-pill dp-1"><span class="dot">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5850EC" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </svg>
              </span>6 proyectos</div>
            <div class="hero-pill dp-2"><span class="dot">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8834A" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
              </span>del brief a la entrega</div>
          </div>
        </div>
      </div>
    </header>

    <section class="work-section" id="proyectos" style="background: var(--bg-soft);">
      <div class="container">
        <div class="work-intro">
          <div class="work-intro-text">
            <span class="section-label">/ enfoque</span>
            <p class="work-intro-lead">Cada proyecto empieza con una pregunta: <em>¿qué tiene que entender
              quien lo ve?</em> A partir de ahí, diseño, estrategia e IA trabajan juntos para que la
              respuesta sea clara, coherente y medible.</p>
            <p>Trabajo para empresas tecnológicas, instituciones públicas y marcas en crecimiento:
              desde identidades completas y stands de feria hasta dashboards industriales y
              estrategias de contenido para redes.</p>
          </div>
          <dl class="work-stats">
            <div><dt>+8</dt><dd>años diseñando marcas, campañas e interfaces</dd></div>
            <div><dt>4</dt><dd>organizaciones: empresa, industria e institución pública</dd></div>
            <div><dt>5</dt><dd>disciplinas: branding, marketing, UI/UX, diseño e IA</dd></div>
          </dl>
        </div>

        <div class="work-grid">
          {tarjetas.map((t) => <ProjectCard tarjeta={t} lang="es" pagina="trabajo/" />)}
        </div>
      </div>
    </section>

    <section id="contacto">
      <div class="container">
        <ContactCards lang="es" />
      </div>
    </section>

  </main>
</Base>
