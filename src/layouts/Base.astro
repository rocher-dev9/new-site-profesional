---
// ────────────────────────────────────────────────────────────────
// Plantilla común de todas las páginas: <head>, menú, pie y scripts.
// Las páginas pueden añadir scripts propios con <Fragment slot="scripts">.
// Cada página solo aporta su contenido (índice lateral + <main>).
// ────────────────────────────────────────────────────────────────
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { rutas, rel, urlAbsoluta, type Lang, type Seccion, type Alternas } from '../i18n/rutas';
import { useT } from '../i18n/ui';
// Estilos: tres archivos separados para editarlos con orden, que Astro combina en un
// único CSS minificado con huella en el nombre (caché automática), siempre en este orden.
// ia.css y caso.css solo afectan a sus propias clases (.theme-ai, .case…).
// Fuentes servidas desde la propia web (sin Google Fonts: ninguna visita envía datos a terceros)
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';
import '../styles/ia.css';
import '../styles/caso.css';

interface Props {
  lang: Lang;
  pagina: string;             // ruta de esta página: "trabajo.html", "en/work.html"…
  titulo: string;
  descripcion: string;
  activa?: Seccion;           // apartado del menú marcado
  subpagina?: boolean;        // casos de estudio: Trabajo marcado sin aria-current
  alternas?: Alternas;        // versiones en cada idioma (hreflang); por defecto, las de "activa"
  colorTema?: string;
  claseBody?: string;
}
const {
  lang, pagina, titulo, descripcion, activa, subpagina = false,
  colorTema = '#5850EC', claseBody,
} = Astro.props;
const t = useT(lang);

// Versiones de esta página en cada idioma
const alternas: Alternas = Astro.props.alternas ?? (activa ? { ...rutas[activa] } : { [lang]: pagina });
// Si falta la traducción, el selector lleva a la sección equivalente (o a la portada)
const respaldo = rutas[activa ?? 'inicio'];
const cambio = { es: alternas.es ?? respaldo.es, en: alternas.en ?? respaldo.en };
const a = (ruta: string) => rel(pagina, ruta);
---
<!DOCTYPE html>
<html lang={lang}>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <meta name="theme-color" content={colorTema} />

  <link rel="icon" href={a('favicon.ico') + '?v=2'} sizes="32x32" />
  <link rel="icon" href={a('img/favicon.svg') + '?v=2'} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={a('img/apple-touch-icon.png') + '?v=2'} />
  {alternas.es !== undefined && <link rel="alternate" hreflang="es" href={urlAbsoluta(alternas.es)} />}
  {alternas.en !== undefined && <link rel="alternate" hreflang="en" href={urlAbsoluta(alternas.en)} />}
  <link rel="alternate" hreflang="x-default" href={urlAbsoluta(alternas.es ?? alternas.en ?? pagina)} />


</head>

<body class={claseBody}>
  <a class="skip-link" href="#main">{t('skip')}</a>

  <Nav lang={lang} pagina={pagina} activa={activa} actual={!subpagina} cambio={cambio} />

  <slot />

  <Footer lang={lang} pagina={pagina} />

  <!-- Script común (src/scripts/global.ts): Astro lo compila y minifica -->
  <script>
    import '../scripts/global.ts';
  </script>
  <!-- Scripts propios de algunas páginas (IOI, robot…), después del común -->
  <slot name="scripts" />
</body>

</html>
