---
// Menú principal (cápsula con iconos) y menú móvil, comunes a todas las páginas
import BrandHand from './BrandHand.astro';
import NavIcon from './NavIcon.astro';
import LangSwitch from './LangSwitch.astro';
import GithubIcon from './GithubIcon.astro';
import { GITHUB } from '../datos/sitio';
import { rutas, rel, type Lang, type Seccion } from '../i18n/rutas';
import { useT } from '../i18n/ui';
import { fichaManual } from '../datos/manual';
import { rutaDelCaso } from '../proyectos/enlaces';

interface Props {
  lang: Lang;
  pagina: string;                 // ruta de la página actual, p. ej. "en/work.html"
  activa?: Seccion;               // apartado marcado en el menú
  actual?: boolean;               // false en subpáginas (casos): se marca sin aria-current
  cambio: Record<Lang, string>;   // destino del selector ES/EN
}
const { lang, pagina, activa, actual = true, cambio } = Astro.props;
const t = useT(lang);
// Apartados del menú (privacidad solo aparece en el pie)
type Apartado = Exclude<Seccion, 'privacidad'>;
const items: Apartado[] = ['inicio', 'entorno', 'trabajo', 'ioi', 'sobreMi'];
const href = (s: Apartado) => rel(pagina, rutas[s][lang]);
// Desplegable de Trabajo: los proyectos y el manual de Vercel
const proyectos = [
  { nombre: 'Intera', ruta: await rutaDelCaso('intera', lang) ?? rutas.trabajo[lang] },
  { nombre: 'Sensing', ruta: await rutaDelCaso('sensing-dashboard', lang) ?? rutas.trabajo[lang] },
  { nombre: 'nVision', ruta: await rutaDelCaso('nvision-ferias', lang) ?? rutas.trabajo[lang] },
  { nombre: 'Vercel', ruta: fichaManual[lang] },
];
const mail = 'mailto:roger.ar123@gmail.com';
// En la portada el logo sube al principio de la página
const enPortada = activa === 'inicio';
---
<!-- NAV -->
<nav class="nav" id="nav" aria-label={t('nav.aria')}>
  <div class="container nav-row">
    <a href={enPortada ? '#top' : href('inicio')} class="brand" id={enPortada ? 'brand-link' : undefined} aria-label={t('nav.marca')} title="Roger Avellana"><BrandHand /></a>
    <div class="nav-links">
      <div class="nav-pill">
        {items.map((s) => s === 'trabajo' ? (
          <div class:list={['nv-grupo', { 'is-active': s === activa }]} id="nv-trabajo">
            <a href={href(s)} class="nv-item" aria-current={s === activa && actual ? 'page' : undefined}><NavIcon name={s} class="nv-ico" /><span>{t(`nav.${s}`)}</span></a>
            <button type="button" class="nv-caret" aria-expanded="false" aria-controls="nv-sub" aria-label={t('nav.proyectos')}>
              <svg viewBox="0 0 12 6" width="10" height="5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M0 0h2v2H0zM10 0h2v2h-2zM2 2h2v2H2zM8 2h2v2H8zM4 4h4v2H4z" /></svg>
            </button>
            <ul class="nv-sub" id="nv-sub">
              {proyectos.map((p) => (
                <li><a href={rel(pagina, p.ruta)} aria-current={p.ruta === pagina ? 'page' : undefined}>{p.nombre}</a></li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={href(s)} class:list={['nv-item', { 'nv-ai': s === 'ioi', 'is-active': s === activa }]} aria-current={s === activa && actual ? 'page' : undefined}><NavIcon name={s} class="nv-ico" /><span>{t(`nav.${s}`)}</span></a>
        ))}
      </div>
      <a href={GITHUB} class="nav-gh" target="_blank" rel="noopener" aria-label={t('nav.github')} title="GitHub"><GithubIcon class="nav-gh-ico" /></a>
      <LangSwitch lang={lang} pagina={pagina} cambio={cambio} />
    </div>
    <button class="nav-burger" id="burger" aria-expanded="false" aria-controls="mobile-menu">{t('nav.menu')}</button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu">
  {items.map((s) => (
    <>
      <a href={href(s)} class:list={['mobile-item', { 'mobile-ai': s === 'ioi' }]} data-close><NavIcon name={s} class="mv-ico" />{t(`nav.${s}`)}</a>
      {s === 'trabajo' && (
        <div class="mobile-sub">
          {proyectos.map((p) => (
            <a href={rel(pagina, p.ruta)} aria-current={p.ruta === pagina ? 'page' : undefined} data-close>{p.nombre}</a>
          ))}
        </div>
      )}
    </>
  ))}
  <a href={GITHUB} class="mobile-item" target="_blank" rel="noopener"><GithubIcon class="mv-ico" />GitHub</a>
  <div class="mobile-cta">
    <a href={mail} class="btn btn-ghost">{t('nav.email')}</a>
  </div>
  <LangSwitch lang={lang} pagina={pagina} cambio={cambio} />
</div>
