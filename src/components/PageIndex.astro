---
// Índice lateral numerado (01, 02…) y botón de volver arriba.
// secciones: pares [id de la sección, nombre]; oscuro: para páginas de fondo oscuro (IOI).
import type { Lang } from '../i18n/rutas';
import { useT } from '../i18n/ui';

interface Props { lang: Lang; secciones: [string, string][]; oscuro?: boolean }
const { lang, secciones, oscuro = false } = Astro.props;
const t = useT(lang);
const dos = (n: number) => String(n).padStart(2, '0');
---
<nav class:list={['page-index', { 'on-dark': oscuro }]} data-dark={oscuro ? '' : undefined} aria-label={t('indice.aria')}>
  {secciones.map(([id, nombre], i) => <a href={`#${id}`}><b>{dos(i + 1)}</b><i aria-hidden="true"></i><span>{nombre}</span></a>)}
</nav>
<a href="#top" class="to-top" aria-label={t('arriba')}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg></a>
