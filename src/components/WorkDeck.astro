---
// Cabecera de Trabajo: baraja de proyectos que avanza sola (src/scripts/modulos/baraja-trabajo.ts).
// Al pulsar una carta, la página baja a la fila de ese proyecto (#p-<clave>).
import ProjectCover from './ProjectCover.astro';
import type { Lang } from '../i18n/rutas';
import { useT } from '../i18n/ui';
import { tarjetas, nombreProyecto } from '../proyectos/tarjetas';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const pasos = t('deck.pasos').split('|');
---
<div class="work-deck" id="work-deck" role="region" aria-roledescription={lang === 'es' ? 'carrusel' : 'carousel'} aria-label={t('deck.aria')}>
  <div class="deck-stage" id="deck-stage">
    {tarjetas.map((p, k) => (
      <div class="deck-card" style={`--deck-color: ${p.fondo};`} data-proyecto={`p-${p.clave}`} aria-hidden={k === 0 ? 'false' : 'true'}>
        <ProjectCover tarjeta={p} lang={lang} />
        <div class="deck-body">
          <strong>{nombreProyecto(p, lang)}</strong>
          <div class="deck-steps">{pasos.map((paso) => <span>{paso}</span>)}</div>
          <div class="deck-progress"><i></i>{Array.from({ length: 16 }, (_, s) => <b style={`--s:${s}`}></b>)}</div>
        </div>
      </div>
    ))}
  </div>
  <div class="deck-controls">
    <button class="deck-btn" id="deck-prev" type="button" aria-label={t('deck.anterior')}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
    </button>
    <div class="deck-dots" id="deck-dots">
      {tarjetas.map((p, k) => (
        <button type="button" style={`--dot-color: ${p.fondo};`} aria-label={`${t('deck.ver')} ${k + 1}: ${nombreProyecto(p, lang)}`}></button>
      ))}
    </div>
    <button class="deck-btn" id="deck-next" type="button" aria-label={t('deck.siguiente')}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
  </div>
  <div class="deck-pills" aria-hidden="true">
    <div class="hero-pill dp-1"><span class="dot"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5850EC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg></span>{tarjetas.length} {t('deck.proyectos')}</div>
    <div class="hero-pill dp-2"><span class="dot"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8834A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg></span>{t('deck.proceso')}</div>
  </div>
</div>
