---
// Tarjeta de proyecto (portada). Los datos están en src/proyectos/tarjetas.ts
// y la ilustración en src/proyectos/<clave>/Tarjeta.astro.
import PixelArrow from './PixelArrow.astro';
import ProjectCover from './ProjectCover.astro';
import type { Lang } from '../i18n/rutas';
import { enlaceCaso } from '../proyectos/enlaces';
import { useT } from '../i18n/ui';
import { nombreProyecto, type Tarjeta } from '../proyectos/tarjetas';

interface Props { tarjeta: Tarjeta; lang: Lang; pagina: string }
const { tarjeta, lang, pagina } = Astro.props;
const t = useT(lang);

// «Ver caso» enlaza al caso de estudio si ya existe en este idioma
const href = await enlaceCaso(tarjeta.clave, lang, pagina);
---
<article class="project-card">
  <ProjectCover tarjeta={tarjeta} lang={lang} />
  <div class="project-body">
    <h3>{nombreProyecto(tarjeta, lang)}</h3>
    <p>{tarjeta.texto[lang]}</p>
    <a href={href} class="btn-link">{t('proyecto.ver')} <PixelArrow /></a>
  </div>
</article>
