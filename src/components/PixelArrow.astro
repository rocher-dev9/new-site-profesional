---
// Flecha pixel de 8×5 (enlaces y botones). back = apunta a la izquierda
interface Props { back?: boolean }
const { back = false } = Astro.props;
---
<svg class:list={['px-arrow', { 'px-arrow--back': back }]} viewBox="0 0 8 5" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><rect x="4" y="0" width="1" height="1"/><rect x="4" y="1" width="2" height="1"/><rect x="0" y="2" width="7" height="1"/><rect x="4" y="3" width="2" height="1"/><rect x="4" y="4" width="1" height="1"/></svg>
