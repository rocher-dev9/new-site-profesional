---
// Entregables del proyecto: piezas del mosaico (cg-item, cg-wide, cg-full).
// Textos en los dos idiomas con t('español', 'inglés'), según la página.
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => (lang === 'en' ? en : es);
---
<figure class="cg-item cg-wide">
  <div class="cg-media cg-media--soft">
    <svg viewBox="0 0 520 300" role="img" aria-label={t('Serie de tres carteles de campaña', 'Series of three campaign posters')} font-family="Plus Jakarta Sans, sans-serif">
      <defs><filter id="cg-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#15121f" flood-opacity=".18" /></filter></defs>
      <g filter="url(#cg-sh)">
        <g>
          <rect x="50" y="40" width="130" height="190" rx="4" fill="#D9482C" />
          <circle cx="115" cy="100" r="32" fill="#fbe2c6" /><circle cx="115" cy="100" r="15" fill="#D9482C" opacity=".5" />
          <rect x="66" y="152" width="98" height="12" rx="2" fill="#fff" />
          <rect x="66" y="169" width="70" height="12" rx="2" fill="#fff" />
          <rect x="66" y="196" width="58" height="4" rx="2" fill="#fff" opacity=".6" />
          <rect x="50" y="214" width="130" height="16" fill="#15121f" />
        </g>
        <g transform="translate(145 -14)">
          <rect x="50" y="40" width="130" height="190" rx="4" fill="#fff" />
          <text x="64" y="92" font-size="30" font-weight="800" letter-spacing="-1" fill="#D9482C">FEM</text>
          <text x="64" y="124" font-size="30" font-weight="800" letter-spacing="-1" fill="#15121f">BARRI</text>
          <rect x="64" y="146" width="90" height="4" rx="2" fill="#15121f" opacity=".35" />
          <rect x="64" y="156" width="64" height="4" rx="2" fill="#15121f" opacity=".35" />
          <rect x="50" y="214" width="130" height="16" fill="#D9482C" />
        </g>
        <g transform="translate(290 0)">
          <rect x="50" y="40" width="130" height="190" rx="4" fill="#15121f" />
          <rect x="66" y="58" width="98" height="78" rx="3" fill="#fbe2c6" />
          <path d="M92 116l18-30 14 20 8-10 14 20z" fill="#D9482C" />
          <rect x="66" y="152" width="98" height="12" rx="2" fill="#fff" />
          <rect x="66" y="169" width="60" height="12" rx="2" fill="#fff" />
          <rect x="146" y="196" width="18" height="18" rx="3" fill="#D9482C" />
        </g>
      </g>
      <text x="50" y="270" font-family="JetBrains Mono, monospace" font-size="11" fill="#837f99">A3 · A2 · mupi 120×176</text>
    </svg>
  </div>
  <figcaption>{t('Cartelería · serie de campaña', 'Posters · campaign series')}</figcaption>
</figure>

<figure class="cg-item">
  <div class="cg-media cg-palette">
    <span style="--sw:#D9482C; --tx:#fff;"><b>{t('Rojo ciudad', 'City red')}</b>#D9482C</span>
    <span style="--sw:#15121F; --tx:#fff;"><b>{t('Tinta', 'Ink')}</b>#15121F</span>
    <span style="--sw:#FBE2C6;"><b>{t('Crema', 'Cream')}</b>#FBE2C6</span>
    <span style="--sw:#FFFFFF;"><b>{t('Blanco', 'White')}</b>#FFFFFF</span>
  </div>
  <figcaption>{t('Sistema de color', 'Color system')}</figcaption>
</figure>

<figure class="cg-item">
  <div class="cg-media cg-type cg-headlines">
    <ul>
      <li>Fem barri, fem ciutat.</li>
      <li>Igualada recicla. I tu?</li>
      <li>La teva ciutat, el teu pla.</li>
    </ul>
    <span>{t('titulares cortos · en catalán · verbo + ciudad', 'short headlines · in Catalan · verb + city')}</span>
  </div>
  <figcaption>{t('Titulares · tono de campaña', 'Headlines · campaign tone')}</figcaption>
</figure>

<figure class="cg-item cg-wide">
  <div class="cg-media cg-media--grid">
    <svg viewBox="0 0 520 300" role="img" aria-label={t('Banners digitales en varios formatos', 'Digital banners in several formats')} font-family="Plus Jakarta Sans, sans-serif">
      <g>
        <rect x="40" y="36" width="440" height="56" rx="4" fill="#D9482C" />
        <text x="58" y="70" font-size="18" font-weight="800" fill="#fff">Fem barri, fem ciutat.</text>
        <rect x="388" y="50" width="76" height="28" rx="14" fill="#fff" />
        <rect x="402" y="61" width="48" height="6" rx="3" fill="#D9482C" />
      </g>
      <g>
        <rect x="40" y="112" width="180" height="150" rx="4" fill="#fbe2c6" stroke="#15121f" stroke-opacity=".08" />
        <circle cx="130" cy="160" r="26" fill="#D9482C" />
        <rect x="60" y="204" width="120" height="10" rx="2" fill="#15121f" />
        <rect x="60" y="220" width="80" height="10" rx="2" fill="#15121f" />
        <rect x="60" y="240" width="40" height="10" rx="5" fill="#D9482C" />
      </g>
      <g>
        <rect x="240" y="112" width="84" height="150" rx="4" fill="#15121f" />
        <text x="252" y="146" font-size="15" font-weight="800" fill="#fff">FEM</text>
        <text x="252" y="164" font-size="15" font-weight="800" fill="#D9482C">BARRI</text>
        <rect x="252" y="232" width="60" height="16" rx="8" fill="#D9482C" />
      </g>
      <g>
        <rect x="344" y="112" width="84" height="150" rx="10" fill="#fff" stroke="#15121f" stroke-opacity=".12" />
        <rect x="352" y="122" width="68" height="70" rx="4" fill="#D9482C" />
        <circle cx="386" cy="157" r="14" fill="#fbe2c6" />
        <rect x="352" y="202" width="60" height="7" rx="2" fill="#15121f" />
        <rect x="352" y="214" width="44" height="7" rx="2" fill="#15121f" />
      </g>
      <g font-family="JetBrains Mono, monospace" font-size="10" fill="#837f99">
        <text x="40" y="282">728×90</text><text x="144" y="282">300×250</text><text x="240" y="282">300×600</text><text x="344" y="282">story 9:16</text>
      </g>
    </svg>
  </div>
  <figcaption>{t('Banners digitales · formatos', 'Digital banners · formats')}</figcaption>
</figure>

<figure class="cg-item cg-full">
  <div class="cg-media cg-posts">
    <div class="cg-post" style="--pb:#D9482C; --pt:#fff;"><span>Fem barri,<br />fem ciutat.</span><i></i></div>
    <div class="cg-post" style="--pb:#FBE2C6; --pt:#15121f;"><span class="cg-post-big">12</span><span>activitats<br />aquest mes</span></div>
    <div class="cg-post" style="--pb:#15121f; --pt:#fff;"><span>Consulta<br />l'agenda →</span><i></i></div>
    <div class="cg-post" style="--pb:#fff; --pt:#15121f;"><span class="cg-post-logo" aria-hidden="true"></span><span>Ajuntament<br />d'Igualada</span></div>
  </div>
  <figcaption>{t('Redes sociales · plantillas', 'Social media · templates')}</figcaption>
</figure>
