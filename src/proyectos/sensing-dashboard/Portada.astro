---
// Ilustración de la portada (viewBox 1200×500): portátil con el panel de la planta y móvil con una alarma.
// El texto alternativo está en los datos del proyecto.
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => (lang === 'en' ? en : es);
---
<defs><filter id="cc-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#15121f" flood-opacity=".3" /></filter></defs>
<g fill="#fff" opacity=".14" shape-rendering="crispEdges">
  <rect x="80" y="70" width="16" height="16" /><rect x="112" y="70" width="16" height="16" /><rect x="80" y="102" width="16" height="16" />
  <rect x="1104" y="380" width="16" height="16" /><rect x="1072" y="412" width="16" height="16" /><rect x="1104" y="412" width="16" height="16" />
</g>
<g font-family="JetBrains Mono, monospace" fill="#fff">
  <text x="110" y="244" font-size="15" opacity=".75">{t('planta · línea 2', 'plant · line 2')}</text>
  <text x="110" y="272" font-size="15" opacity=".5">{t('12 sensores activos', '12 active sensors')}</text>
</g>
<g filter="url(#cc-sh)">
  <g>
    <rect x="380" y="70" width="520" height="330" rx="14" fill="#15121f" />
    <rect x="394" y="84" width="492" height="302" rx="6" fill="#f2f5f3" />
    <rect x="394" y="84" width="64" height="302" fill="#fff" />
    <rect x="412" y="102" width="28" height="28" rx="6" fill="#0E8A5A" />
    <rect x="416" y="148" width="20" height="4" rx="2" fill="#15121f" opacity=".25" />
    <rect x="416" y="166" width="20" height="4" rx="2" fill="#15121f" opacity=".25" />
    <rect x="416" y="184" width="20" height="4" rx="2" fill="#15121f" opacity=".25" />
    <g>
      <rect x="474" y="100" width="122" height="62" rx="8" fill="#fff" />
      <circle cx="490" cy="116" r="5" fill="#0E8A5A" /><rect x="502" y="112" width="60" height="7" rx="3.5" fill="#15121f" opacity=".3" />
      <text x="486" y="150" font-family="Plus Jakarta Sans, sans-serif" font-size="20" font-weight="800" fill="#15121f">98%</text>
    </g>
    <g>
      <rect x="606" y="100" width="122" height="62" rx="8" fill="#fff" />
      <circle cx="622" cy="116" r="5" fill="#E0A82E" /><rect x="634" y="112" width="60" height="7" rx="3.5" fill="#15121f" opacity=".3" />
      <text x="618" y="150" font-family="Plus Jakarta Sans, sans-serif" font-size="20" font-weight="800" fill="#15121f">42,7°</text>
    </g>
    <g>
      <rect x="738" y="100" width="134" height="62" rx="8" fill="#fde5df" />
      <circle cx="754" cy="116" r="5" fill="#D9482C" /><rect x="766" y="112" width="60" height="7" rx="3.5" fill="#D9482C" opacity=".5" />
      <text x="750" y="150" font-family="Plus Jakarta Sans, sans-serif" font-size="20" font-weight="800" fill="#D9482C">1</text>
    </g>
    <rect x="474" y="174" width="398" height="196" rx="8" fill="#fff" />
    <line x1="494" y1="236" x2="852" y2="236" stroke="#E0A82E" stroke-width="2" stroke-dasharray="6 5" />
    <polyline points="494,320 530,300 566,310 602,282 638,292 674,262 710,272 746,248 782,258 818,226 852,240" fill="none" stroke="#0E8A5A" stroke-width="4" stroke-linejoin="round" stroke-linecap="round" />
    <circle cx="818" cy="226" r="7" fill="#D9482C" />
    <rect x="494" y="192" width="120" height="8" rx="4" fill="#15121f" opacity=".3" />
    <path d="M340 400h600l-34 24H374z" fill="#2a2730" />
  </g>
  <g>
    <rect x="930" y="150" width="140" height="282" rx="22" fill="#15121f" />
    <rect x="940" y="164" width="120" height="254" rx="14" fill="#fff" />
    <rect x="948" y="180" width="104" height="66" rx="10" fill="#fde5df" />
    <circle cx="962" cy="196" r="6" fill="#D9482C" />
    <text x="974" y="201" font-family="Plus Jakarta Sans, sans-serif" font-size="12" font-weight="800" fill="#D9482C">{t('Alarma', 'Alarm')}</text>
    <rect x="956" y="214" width="84" height="6" rx="3" fill="#D9482C" opacity=".45" />
