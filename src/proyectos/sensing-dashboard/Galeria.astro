---
// Entregables del proyecto: piezas del mosaico (cg-item, cg-wide, cg-full).
// Textos en los dos idiomas con t('español', 'inglés'), según la página.
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => (lang === 'en' ? en : es);
---
<figure class="cg-item cg-wide">
  <div class="cg-media cg-media--grid">
    <svg viewBox="0 0 520 300" role="img" aria-label={t('Panel general con el estado de cada línea de la planta', 'Overview panel with the status of each plant line')} font-family="Plus Jakarta Sans, sans-serif">
      <defs><filter id="cg-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#15121f" flood-opacity=".14" /></filter></defs>
      <g filter="url(#cg-sh)">
        <rect x="40" y="30" width="440" height="240" rx="10" fill="#fff" />
      </g>
      <rect x="40" y="30" width="440" height="34" rx="10" fill="#15121f" />
      <rect x="40" y="52" width="440" height="12" fill="#15121f" />
      <circle cx="60" cy="47" r="6" fill="#0E8A5A" />
      <text x="74" y="51" font-size="11" font-weight="700" fill="#fff">{t('Planta Igualada · en directo', 'Igualada plant · live')}</text>
      <g font-size="10" fill="#837f99">
        <rect x="56" y="80" width="126" height="78" rx="8" fill="#eef6f2" /><circle cx="70" cy="94" r="5" fill="#0E8A5A" />
        <text x="82" y="98">{t('Línea 1', 'Line 1')}</text><text x="68" y="138" font-size="22" font-weight="800" fill="#15121f">OK</text>
        <rect x="196" y="80" width="126" height="78" rx="8" fill="#fbf3e2" /><circle cx="210" cy="94" r="5" fill="#E0A82E" />
        <text x="222" y="98">{t('Línea 2', 'Line 2')}</text><text x="208" y="138" font-size="22" font-weight="800" fill="#15121f">{t('Aviso', 'Warn')}</text>
        <rect x="336" y="80" width="126" height="78" rx="8" fill="#fde5df" /><circle cx="350" cy="94" r="5" fill="#D9482C" />
        <text x="362" y="98">{t('Línea 3', 'Line 3')}</text><text x="348" y="138" font-size="22" font-weight="800" fill="#D9482C">{t('Alarma', 'Alarm')}</text>
      </g>
      <polyline points="56,240 96,226 136,232 176,212 216,220 256,198 296,206 336,190 376,196 416,178 462,186" fill="none" stroke="#0E8A5A" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
      <line x1="56" y1="200" x2="462" y2="200" stroke="#E0A82E" stroke-width="1.5" stroke-dasharray="5 4" />
      <text x="56" y="182" font-size="10" fill="#837f99">{t('Consumo energético · 24 h', 'Energy use · 24 h')}</text>
    </svg>
  </div>
  <figcaption>{t('Panel general · estado de la planta', 'Overview · plant status')}</figcaption>
</figure>

<figure class="cg-item">
  <div class="cg-media cg-palette">
    <span style="--sw:#0E8A5A; --tx:#fff;"><b>{t('Correcto', 'Normal')}</b>#0E8A5A</span>
    <span style="--sw:#E0A82E;"><b>{t('Aviso', 'Warning')}</b>#E0A82E</span>
    <span style="--sw:#D9482C; --tx:#fff;"><b>{t('Alarma', 'Alarm')}</b>#D9482C</span>
    <span style="--sw:#F2F5F3;"><b>{t('Fondo', 'Background')}</b>#F2F5F3</span>
  </div>
  <figcaption>{t('Código de color de estados', 'Status color code')}</figcaption>
</figure>

<figure class="cg-item">
  <div class="cg-media cg-type cg-sensor">
    <span class="cg-sensor-label">{t('Compresor 3 · temperatura', 'Compressor 3 · temperature')}</span>
    <span class="cg-sensor-value">42,7<small>°C</small></span>
    <svg viewBox="0 0 200 50" aria-hidden="true"><polyline points="0,40 25,34 50,37 75,26 100,30 125,18 150,22 175,10 200,14" fill="none" stroke="#8ff5d2" stroke-width="3" stroke-linejoin="round" /></svg>
    <span>{t('tarjeta de sensor · modo oscuro para planta', 'sensor card · dark mode for the plant floor')}</span>
  </div>
  <figcaption>{t('Componente · tarjeta de sensor', 'Component · sensor card')}</figcaption>
</figure>

<figure class="cg-item cg-wide">
  <div class="cg-media cg-media--soft">
    <svg viewBox="0 0 520 300" role="img" aria-label={t('Detalle de un equipo con su gráfico de temperatura y los umbrales de aviso y alarma', 'Machine detail with its temperature chart and warning and alarm thresholds')} font-family="Plus Jakarta Sans, sans-serif">
      <rect x="40" y="30" width="440" height="240" rx="10" fill="#fff" />
      <text x="62" y="62" font-size="15" font-weight="800" fill="#15121f">{t('Compresor 3', 'Compressor 3')}</text>
      <text x="62" y="80" font-size="10" fill="#837f99">{t('Temperatura · últimas 6 h', 'Temperature · last 6 h')}</text>
      <rect x="380" y="50" width="80" height="24" rx="12" fill="#fde5df" />
      <text x="396" y="66" font-size="10" font-weight="700" fill="#D9482C">{t('● Alarma', '● Alarm')}</text>
      <rect x="62" y="100" width="398" height="40" fill="#D9482C" opacity=".07" />
      <line x1="62" y1="140" x2="460" y2="140" stroke="#D9482C" stroke-width="1.5" stroke-dasharray="5 4" />
      <line x1="62" y1="168" x2="460" y2="168" stroke="#E0A82E" stroke-width="1.5" stroke-dasharray="5 4" />
      <text x="420" y="134" font-size="9" fill="#D9482C">{t('alarma', 'alarm')}</text>
      <text x="420" y="162" font-size="9" fill="#b58520">{t('aviso', 'warning')}</text>
      <polyline points="62,230 102,222 142,226 182,208 222,214 262,196 302,186 342,170 382,150 422,128 460,122" fill="none" stroke="#0E8A5A" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
      <circle cx="422" cy="128" r="6" fill="#D9482C" />
      <g font-size="9" fill="#837f99"><text x="62" y="252">08:00</text><text x="180" y="252">10:00</text><text x="300" y="252">12:00</text><text x="420" y="252">14:00</text></g>
    </svg>
  </div>
  <figcaption>{t('Detalle de equipo · series temporales y umbrales', 'Machine detail · time series and thresholds')}</figcaption>
</figure>

<figure class="cg-item cg-full">
  <div class="cg-media cg-posts">
    <div class="cg-post" style="--pb:#0E8A5A; --pt:#fff;"><span class="cg-post-big" style="color:#fff">98%</span><span>{t('disponibilidad', 'availability')}<br />{t('de la línea', 'of the line')}</span></div>
    <div class="cg-post" style="--pb:#FDE5DF; --pt:#D9482C;"><span>{t('● Alarma', '● Alarm')}<br />{t('Compresor 3', 'Compressor 3')}</span><i></i></div>
    <div class="cg-post" style="--pb:#15121f; --pt:#fff;"><span>{t('Ver', 'View')}<br />{t('histórico →', 'history →')}</span></div>
    <div class="cg-post" style="--pb:#fff; --pt:#15121f;"><span class="cg-post-logo" aria-hidden="true"></span><span>{t('Filtros', 'Filters')}<br />{t('por línea', 'by line')}</span></div>
  </div>
  <figcaption>{t('Librería de componentes · indicadores, alertas, botones y filtros', 'Component library · indicators, alerts, buttons and filters')}</figcaption>
</figure>
