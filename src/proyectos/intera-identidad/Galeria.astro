---
// Entregables del proyecto: piezas del mosaico (cg-item, cg-wide, cg-full).
// Los pies de foto están en español; en la versión inglesa se traducen con la prop lang.
interface Props { lang?: 'es' | 'en' }
---
<figure class="cg-item cg-wide">
  <div class="cg-media cg-media--grid">
    <svg viewBox="0 0 520 300" role="img" aria-label="Logotipo de Intera sobre su retícula de construcción" font-family="Plus Jakarta Sans, sans-serif">
      <g fill="none" stroke="#504FED" stroke-width="1" opacity=".35" stroke-dasharray="4 4">
        <circle cx="150" cy="150" r="70" /><circle cx="166" cy="134" r="28" />
        <line x1="40" y1="150" x2="480" y2="150" /><line x1="150" y1="40" x2="150" y2="260" />
        <line x1="40" y1="80" x2="480" y2="80" /><line x1="40" y1="220" x2="480" y2="220" />
      </g>
      <circle cx="150" cy="150" r="56" fill="#504FED" />
      <circle cx="163" cy="137" r="22" fill="#fff" />
      <text x="232" y="172" font-size="64" font-weight="800" letter-spacing="-3" fill="#15121f">intera</text>
      <g font-family="JetBrains Mono, monospace" font-size="11" fill="#837f99">
        <text x="40" y="74">x</text><text x="40" y="244">x</text>
        <text x="232" y="214">altura de x · 0,5 r</text>
      </g>
    </svg>
  </div>
  <figcaption>Logotipo · retícula de construcción</figcaption>
</figure>

<figure class="cg-item">
  <div class="cg-media cg-palette">
    <span style="--sw:#504FED; --tx:#fff;"><b>Índigo</b>#504FED</span>
    <span style="--sw:#15121F; --tx:#fff;"><b>Tinta</b>#15121F</span>
    <span style="--sw:#FBE2C6;"><b>Melocotón</b>#FBE2C6</span>
    <span style="--sw:#F4F3FB;"><b>Niebla</b>#F4F3FB</span>
  </div>
  <figcaption>Paleta cromática</figcaption>
</figure>

<figure class="cg-item">
  <div class="cg-media cg-type">
    <span class="cg-type-aa" aria-hidden="true">Aa</span>
    <div>
      <strong>Plus Jakarta Sans</strong>
      <span>Regular · Semibold · Extrabold</span>
      <span class="cg-type-chars" aria-hidden="true">ABC abc 123 &amp; @</span>
    </div>
  </div>
  <figcaption>Tipografía</figcaption>
</figure>

<figure class="cg-item cg-wide">
  <div class="cg-media cg-media--soft">
    <svg viewBox="0 0 520 300" role="img" aria-label="Papelería corporativa: tarjetas de visita y hoja de carta" font-family="Plus Jakarta Sans, sans-serif">
      <defs><filter id="cg-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="8" stdDeviation="8" flood-color="#15121f" flood-opacity=".16" /></filter></defs>
      <g filter="url(#cg-sh)">
        <g transform="rotate(-4 160 150)">
          <rect x="50" y="40" width="200" height="250" rx="6" fill="#fff" />
          <circle cx="80" cy="72" r="10" fill="#504FED" /><circle cx="84" cy="68" r="4" fill="#fff" />
          <rect x="74" y="110" width="150" height="5" rx="2.5" fill="#e8e5fb" />
          <rect x="74" y="124" width="130" height="5" rx="2.5" fill="#e8e5fb" />
          <rect x="74" y="138" width="140" height="5" rx="2.5" fill="#e8e5fb" />
          <rect x="74" y="152" width="90" height="5" rx="2.5" fill="#e8e5fb" />
          <rect x="50" y="270" width="200" height="20" fill="#504FED" />
        </g>
        <g transform="rotate(6 380 120)">
          <rect x="290" y="60" width="190" height="110" rx="8" fill="#504FED" />
          <circle cx="385" cy="108" r="18" fill="#fff" /><circle cx="392" cy="101" r="7" fill="#504FED" />
        </g>
        <g transform="rotate(-3 380 220)">
          <rect x="280" y="170" width="190" height="110" rx="8" fill="#fff" />
          <text x="302" y="212" font-size="16" font-weight="800" fill="#15121f">Nombre Apellido</text>
          <text x="302" y="232" font-size="11" fill="#837f99">Cargo · Intera</text>
          <rect x="302" y="252" width="80" height="4" rx="2" fill="#dbd6f9" />
          <circle cx="444" cy="196" r="9" fill="#504FED" /><circle cx="448" cy="192" r="3.5" fill="#fff" />
        </g>
      </g>
    </svg>
  </div>
  <figcaption>Papelería corporativa</figcaption>
</figure>

<figure class="cg-item cg-full">
  <div class="cg-media cg-posts">
    <div class="cg-post" style="--pb:#504FED; --pt:#fff;"><span>Tecnología<br />que se entiende.</span><i></i></div>
    <div class="cg-post" style="--pb:#FBE2C6; --pt:#15121f;"><span class="cg-post-big">+30</span><span>nuevos clientes<br />este año</span></div>
    <div class="cg-post" style="--pb:#15121f; --pt:#fff;"><span>Conoce al<br />equipo →</span><i></i></div>
    <div class="cg-post" style="--pb:#fff; --pt:#15121f;"><span class="cg-post-logo" aria-hidden="true"></span><span>intera</span></div>
  </div>
  <figcaption>Redes sociales · plantillas</figcaption>
</figure>
