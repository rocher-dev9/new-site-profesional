---
// Ilustración de la portada (viewBox 1200×500): stand de feria con pared de fondo, roll-ups, mostrador y pantalla.
// El texto alternativo está en los datos del proyecto.
interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => (lang === 'en' ? en : es);
---
<defs><filter id="cc-sh" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#15121f" flood-opacity=".28" /></filter></defs>
<g fill="#fff" opacity=".16" shape-rendering="crispEdges">
  <rect x="80" y="70" width="16" height="16" /><rect x="112" y="70" width="16" height="16" /><rect x="80" y="102" width="16" height="16" />
  <rect x="1072" y="60" width="16" height="16" /><rect x="1104" y="60" width="16" height="16" /><rect x="1104" y="92" width="16" height="16" />
</g>
<g font-family="JetBrains Mono, monospace" fill="#15121f">
  <text x="110" y="244" font-size="15" opacity=".7">{t('feria · stand 4B', 'trade fair · booth 4B')}</text>
  <text x="110" y="272" font-size="15" opacity=".5">{t('3 × 6 m · modular', '3 × 6 m · modular')}</text>
</g>
<rect x="300" y="430" width="760" height="16" rx="8" fill="#15121f" opacity=".12" />
<g filter="url(#cc-sh)">
  <rect x="390" y="70" width="560" height="360" rx="6" fill="#15121f" />
  <rect x="390" y="70" width="560" height="56" rx="6" fill="#fff" />
  <circle cx="424" cy="98" r="14" fill="#E0A82E" /><circle cx="428" cy="94" r="5" fill="#15121f" />
  <text x="448" y="106" font-family="Plus Jakarta Sans, sans-serif" font-size="24" font-weight="800" letter-spacing="-1" fill="#15121f">nVision</text>
  <text x="430" y="196" font-family="Plus Jakarta Sans, sans-serif" font-size="34" font-weight="800" letter-spacing="-1.5" fill="#fff">{t('Ver más.', 'See more.')}</text>
  <text x="430" y="238" font-family="Plus Jakarta Sans, sans-serif" font-size="34" font-weight="800" letter-spacing="-1.5" fill="#E0A82E">{t('Fallar menos.', 'Fail less.')}</text>
  <rect x="430" y="262" width="180" height="8" rx="4" fill="#fff" opacity=".35" />
  <rect x="430" y="278" width="130" height="8" rx="4" fill="#fff" opacity=".35" />
  <rect x="700" y="160" width="210" height="130" rx="6" fill="#2a2730" />
  <rect x="710" y="170" width="190" height="110" rx="3" fill="#fbf3e2" />
  <circle cx="805" cy="225" r="34" fill="none" stroke="#E0A82E" stroke-width="6" />
  <circle cx="805" cy="225" r="12" fill="#15121f" />
  <line x1="740" y1="225" x2="870" y2="225" stroke="#15121f" stroke-width="2" stroke-dasharray="4 4" />
  <rect x="560" y="330" width="220" height="100" rx="6" fill="#E0A82E" />
  <rect x="580" y="350" width="90" height="8" rx="4" fill="#15121f" opacity=".5" />
</g>
<g filter="url(#cc-sh)">
  <rect x="300" y="150" width="70" height="280" rx="4" fill="#fff" />
  <rect x="310" y="166" width="50" height="50" rx="25" fill="#E0A82E" />
  <rect x="312" y="232" width="46" height="7" rx="3" fill="#15121f" />
  <rect x="312" y="246" width="34" height="7" rx="3" fill="#15121f" />
  <rect x="296" y="424" width="78" height="8" rx="4" fill="#2a2730" />
  <rect x="970" y="150" width="70" height="280" rx="4" fill="#fff" />
  <text x="982" y="200" font-family="Plus Jakarta Sans, sans-serif" font-size="22" font-weight="800" fill="#E0A82E">0,1</text>
  <text x="982" y="218" font-family="JetBrains Mono, monospace" font-size="10" fill="#15121f">mm</text>
  <rect x="982" y="240" width="46" height="7" rx="3" fill="#15121f" opacity=".5" />
  <rect x="966" y="424" width="78" height="8" rx="4" fill="#2a2730" />
</g>
